    /* Toast custom – keep, but style refined */
    .login-toast {
      visibility: hidden;
      min-width: 260px;
      background: #b91c1c;
      background: linear-gradient(145deg, #b91c1c, #991b1b);
      color: white;
      text-align: center;
      border-radius: 100px;
      padding: 14px 24px;
      position: fixed;
      z-index: 10000;
      left: 50%;
      transform: translateX(-50%);
      bottom: 30px;
      font-size: 1rem;
      font-weight: 500;
      box-shadow: 0 10px 25px -5px rgba(185, 28, 28, 0.3);
      opacity: 0;
      transition: opacity 0.3s ease, bottom 0.3s cubic-bezier(0.2, 0.9, 0.4, 1);
      letter-spacing: 0.3px;
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .login-toast.show {
      visibility: visible;
      opacity: 1;
      bottom: 40px;
    }
  </style>

