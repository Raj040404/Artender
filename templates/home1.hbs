      letter-spacing: 0.3px;
      box-shadow: 0 6px 14px rgba(182, 69, 22, 0.3);
      border: 1px solid rgba(255, 215, 170, 0.5);
    }

    .navbar8-links1 a[href*="sellerregistration"]::after {
      display: none;
    }

    .navbar8-links1 a[href*="sellerregistration"]:hover {
      background: #9e3e1a !important;
      box-shadow: 0 10px 18px rgba(182, 69, 22, 0.4);
      transform: translateY(-2px);
    }

