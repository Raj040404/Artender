  <script>
    function toggleNavbar() {
      const navbarMenu = document.getElementById("navbarMenu");
      navbarMenu.style.display = navbarMenu.style.display === "flex" ? "none" : "flex";
    }

    // Remove the scrollToFooter function as it's no longer needed

    document.body.addEventListener("click", function (event) {
      let target = event.target.closest("a");
      if (target && target.href && !target.href.includes("login") && !target.href.includes("signup")) {
        event.preventDefault();
        let messageBox = document.createElement("div");
        messageBox.innerText = "You need to log in first";
        messageBox.style.position = "absolute";
        messageBox.style.left = event.pageX + "px";
        messageBox.style.top = event.pageY + "px";
        messageBox.style.background = "#333";
        messageBox.style.color = "#fff";
        messageBox.style.padding = "8px 12px";
        messageBox.style.borderRadius = "5px";
        messageBox.style.zIndex = "1000";
        messageBox.style.fontSize = "14px";
        document.body.appendChild(messageBox);
        setTimeout(() => messageBox.remove(), 2000);
      }
    });
  </script>
