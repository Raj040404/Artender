  <style>
    /* Artistic menu button styles */
    .navbar-toggle {
      /* Existing styles remain the same, but we add initial display: none */
      display: none;
      /* ⬅️ Hides the button by default on large screens */
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      background: var(--art-gradient-1);
      border-radius: 50%;
      width: 60px;
      height: 60px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 10px 25px -8px rgba(76, 29, 149, 0.5);
      transition: all 0.3s ease;
      border: 2px solid rgba(255, 255, 255, 0.5);
    }

    .navbar-toggle:hover {
      transform: scale(1.05);
      box-shadow: 0 16px 30px -8px rgba(76, 29, 149, 0.6);
    }

    .artistic-menu-icon {
      position: relative;
      width: 30px;
      height: 24px;
    }

    .brush-stroke {
      position: absolute;
      height: 4px;
      background: white;
      border-radius: 2px;
      transition: all 0.3s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .brush-stroke-1 {
      top: 0;
      width: 100%;
      transform-origin: center;
    }

    .brush-stroke-2 {
      top: 10px;
      width: 80%;
      right: 0;
      transform-origin: right;
    }

    .brush-stroke-3 {
      top: 20px;
      width: 60%;
      transform-origin: center;
    }

    /* Animation when menu is open */
    .navbar-menu[style*="display: flex"]~.navbar-toggle .brush-stroke-1 {
      transform: rotate(45deg) translate(6px, 6px);
      width: 100%;
    }

    .navbar-menu[style*="display: flex"]~.navbar-toggle .brush-stroke-2 {
      opacity: 0;
      transform: translateX(10px);
    }

    .navbar-menu[style*="display: flex"]~.navbar-toggle .brush-stroke-3 {
      transform: rotate(-45deg) translate(6px, -6px);
      width: 100%;
    }

    /* Mobile responsive adjustments */
    @media (max-width: 768px) {

      /* ⬅️ Only display the button on screens 768px wide or less */
      .navbar-toggle {
        display: flex;
        /* ⬅️ Shows the button on mobiles and tablets */
        width: 50px;
        height: 50px;
        top: 15px;
        right: 15px;
      }

      .artistic-menu-icon {
        width: 24px;
        height: 20px;
      }

      .brush-stroke {
        height: 3px;
      }

      .brush-stroke-2 {
        top: 8px;
      }

      .brush-stroke-3 {
        top: 16px;
      }
    }

    .pricing-announcement-buttons {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }

    .pricing-announcement-buttons .thq-button-filled {
      padding: 12px 24px;
      font-size: 1.1rem;
      border-radius: 8px;
    }
  </style>

  <style>
    /* Make the feature sections look clickable */
    .features241-tab-horizontal1,
    .features241-tab-horizontal2,
    .features241-tab-horizontal3 {
      transition: all 0.3s ease;
    }

    .features241-tab-horizontal1:hover,
    .features241-tab-horizontal2:hover,
    .features241-tab-horizontal3:hover {
      transform: translateY(-5px);
    }

    /* Toast styles */
    .login-toast {
      visibility: hidden;
      /* Hidden by default. */
      min-width: 250px;
      /* Set a default minimum width */
      margin-left: -125px;
      /* Divide value of min-width by 2 */
      background: linear-gradient(145deg, #7f1d1d, #991b1b);
      /* Black background color */
      color: #fff;
      /* White text color */
      text-align: center;
      /* Centered text */
      border-radius: 100px;
      /* Rounded borders */
      padding: 16px 24px;
      /* Padding */
      position: fixed;
      /* Sit on top of the screen */
      z-index: 1001;
      /* Add a z-index if needed */
      left: 50%;
      /* Center the snackbar */
      bottom: 30px;
      /* 30px from the bottom */
      box-shadow: 0 10px 25px -5px rgba(127, 29, 29, 0.5);
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      letter-spacing: 0.3px;
      border: 1px solid rgba(254, 202, 202, 0.3);
      backdrop-filter: blur(4px);
    }

    /* Show the snackbar when clicking on a button (class added with JavaScript) */
    .login-toast.show {
      visibility: visible;
      /* Show the snackbar */
      /* Add animation: Take 0.5 seconds to fade in and out the snackbar.
      However, we want the snackbar to stay for 2.5 seconds, so we add a delay of 2.5s before fading out */
      -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
      animation: fadein 0.5s, fadeout 0.5s 2.5s;
    }

    /* Animations to fade the snackbar in and out */
    @-webkit-keyframes fadein {
      from {
        bottom: 0;
        opacity: 0;
      }

      to {
        bottom: 30px;
        opacity: 1;
      }
    }

    @keyframes fadein {
      from {
        bottom: 0;
        opacity: 0;
      }

      to {
        bottom: 30px;
        opacity: 1;
      }
    }

    @-webkit-keyframes fadeout {
      from {
        bottom: 30px;
        opacity: 1;
      }

      to {
        bottom: 0;
        opacity: 0;
      }
    }

    @keyframes fadeout {
      from {
        bottom: 30px;
        opacity: 1;
      }

      to {
        bottom: 0;
        opacity: 0;
      }
    }
  </style>

  <div id="login-toast" class="login-toast">You need to login first</div>

