    .navbar8-links1 a {
      font-size: 1rem;
      font-weight: 550;
      color: #3a2c28;
      position: relative;
      padding: 0.4rem 0;
      transition: color 0.2s;
    }

    .navbar8-links1 a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) scaleX(0);
      width: 80%;
      height: 2px;
      background: var(--gradient-brush);
      transition: transform 0.25s ease;
      border-radius: 2px;
    }

    .navbar8-links1 a:hover {
      color: #b64516;
    }

    .navbar8-links1 a:hover::after {
      transform: translateX(-50%) scaleX(1);
    }

    /* Seller zone button – premium gradient */
    .navbar8-links1 a[href*="sellerregistration"] {
      background: linear-gradient(145deg, #b64516, #9e3e1a) !important;
