    /* ---------- MOBILE MENU – brushstroke toggle (refined) ---------- */
    .navbar-toggle {
      display: none;
      position: fixed;
      top: 20px;
      right: 24px;
      z-index: 1001;
      background: rgba(255, 248, 238, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 50%;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(100, 50, 20, 0.12);
      border: 1px solid rgba(255,255,240,0.5);
      transition: all 0.25s;
    }

    .navbar-toggle:hover {
      background: white;
      transform: scale(1.02);
    }

    .artistic-menu-icon {
      position: relative;
      width: 26px;
      height: 22px;
    }

    .brush-stroke {
      position: absolute;
      height: 3px;
      background: linear-gradient(90deg, #b64516, #bb7a4b);
      border-radius: 4px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
      transition: all 0.3s cubic-bezier(0.34, 1.2, 0.64, 1);
    }

    .brush-stroke-1 { top: 0; width: 100%; }
    .brush-stroke-2 { top: 9px; width: 80%; right: 0; }
    .brush-stroke-3 { top: 18px; width: 60%; }

    /* menu open state animation */
    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-1 {
      transform: rotate(45deg) translate(6px, 7px);
      width: 100%;
      background: #b64516;
    }
    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-2 {
      opacity: 0;
      transform: translateX(14px);
    }
    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-3 {
      transform: rotate(-45deg) translate(6px, -7px);
      width: 100%;
      background: #b64516;
    }

    /* ---------- MOBILE MENU PANEL – artistic, elevated ---------- */
    .navbar-menu {
      display: none;
      position: fixed;
      top: 0;
