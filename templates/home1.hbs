      border-color: #87411f;
      color: #87411f;
    }

    /* ----- MOBILE MENU – brushstroke toggle (same position, enhanced look) ----- */
    .navbar-toggle {
      display: none;
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      background: rgba(255, 248, 238, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 50%;
      width: 60px;
      height: 60px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(100, 50, 20, 0.12);
      border: 1px solid rgba(255,255,240,0.5);
      transition: all 0.25s;
    }

    .navbar-toggle:hover {
      background: white;
      transform: scale(1.02);
    }

    .artistic-menu-icon {
      position: relative;
      width: 30px;
      height: 24px;
    }

    .brush-stroke {
      position: absolute;
      height: 4px;
      background: linear-gradient(90deg, #b64516, #bb7a4b);
      border-radius: 4px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
      transition: all 0.3s cubic-bezier(0.34, 1.2, 0.64, 1);
    }

    .brush-stroke-1 { top: 0; width: 100%; }
    .brush-stroke-2 { top: 10px; width: 80%; right: 0; }
    .brush-stroke-3 { top: 20px; width: 60%; }

    /* Animation when menu is open – same transform */
    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-1 {
      transform: rotate(45deg) translate(6px, 6px);
      width: 100%;
      background: #b64516;
    }

    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-2 {
      opacity: 0;
      transform: translateX(10px);
    }

    .navbar-menu[style*="display: flex"] ~ .navbar-toggle .brush-stroke-3 {
      transform: rotate(-45deg) translate(6px, -6px);
      width: 100%;
      background: #b64516;
    }

