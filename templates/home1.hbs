<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artender</title>
  <link rel="stylesheet" href="/css/home1.css">
  <style>
    /* Style for the login required message */
    .login-required-message {
      color: #ff0000;
      font-size: 16px;
      margin-top: 10px;
      display: none; /* Hidden by default */
    }
  </style>
  <script>
    // Function to display the login required message
    function showLoginRequiredMessage(event) {
      event.preventDefault(); // Prevent default link behavior
      const messageElement = document.querySelector(".login-required-message");
      messageElement.style.display = "block"; // Show the message
    }

    // Attach the function to all links on the page
    document.addEventListener("DOMContentLoaded", function() {
      const links = document.querySelectorAll("nav a");
      links.forEach(link => {
        link.addEventListener("click", showLoginRequiredMessage);
      });
    });
  </script>
</head>
<body>
  <header>
    <div class="logo">Artender</div>
    <nav>
      <a href="#">View Exclusive Art Work</a>
      <a href="#">Explore works</a>
      <a href="#">Participate in Competitions</a>
      <a href="#">Contact</a>
    </nav>
    <div class="auth-buttons">
      <form action="/login" method="get">
        <button type="submit">Login</button>
      </form>
      <form action="/signup" method="get">
        <button type="submit">Signup</button>
      </form>
    </div>
  </header>

  <!-- Message to display when login is required -->
  <div class="login-required-message">Login required to access this feature.</div>

  <main>
    <h1>Artender: Where Creativity Blooms and Art Shines Bright</h1>
    <p>Unleash Creativity, Celebrate Talent: A Platform Where Art Meets Competition and Creativity Finds Its Spotlight.</p>
  </main>
</body>
</html>
