<main class="comingsoon-main">
    <div class="comingsoon-wrapper">
        <h1 class="comingsoon-title">Seller Registration</h1>
        <p class="comingsoon-subtitle">
            Complete your profile to start selling your artwork on Artender.
        </p>
        {{#if alreadyRegistered}}
<div class="enrolled-banner">
    ✅ You have successfully enrolled as a seller on Artender.
</div>
{{/if}}


        <form id="sellerRegistrationForm" class="seller-registration-form" action="/sellerregistration" method="POST">
            <!-- Name -->
            <div class="form-group">
                <label for="name" class="form-label">Full Name *</label>
                <input type="text" id="name" name="name" class="form-input" required>
                <div class="form-error" id="nameError"></div>
            </div>

            <!-- Age -->
            <div class="form-group">
                <label for="age" class="form-label">Age *</label>
                <input type="number" id="age" name="age" class="form-input" min="18" max="120" required>
                <div class="form-error" id="ageError"></div>
            </div>

            <!-- Address -->
            <div class="form-group">
                <label for="address" class="form-label">Address *</label>
                <textarea id="address" name="address" class="form-textarea" rows="3" required></textarea>
                <div class="form-error" id="addressError"></div>
            </div>

            <!-- Mobile -->
            <div class="form-group">
                <label for="mobile" class="form-label">Whatsapp Number *</label>
              <input
  type="tel"
  id="mobile"
  name="mobileNumber"
  class="form-input"
  pattern="[0-9]{10}"
  inputmode="numeric"
  maxlength="10"
  placeholder="Enter 10 digit mobile number"
  required
>

                <div class="form-error" id="mobileError"></div>
            </div>

            <!-- Artwork Categories -->
          <!-- Artwork Categories -->
<div class="form-group">
    <label class="form-label">Artwork Categories *</label>

    <div class="multi-select-dropdown" id="categoryDropdown">
        <div class="dropdown-header" onclick="toggleCategoryDropdown()">
            <span id="selectedCategoriesText">Select Artwork Categories</span>
            <span class="dropdown-arrow">▼</span>
        </div>

        <div class="dropdown-options" id="categoryOptions">
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Painting" onchange="updateSelectedCategories()"> Painting
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Digital Art" onchange="updateSelectedCategories()"> Digital Art
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Sculpture" onchange="updateSelectedCategories()"> Sculpture
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Photography" onchange="updateSelectedCategories()"> Photography
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Traditional Art" onchange="updateSelectedCategories()"> Traditional Art
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Mixed Media" onchange="updateSelectedCategories()"> Mixed Media
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Illustration" onchange="updateSelectedCategories()"> Illustration
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Craft" onchange="updateSelectedCategories()"> Craft
            </label>
            <label class="dropdown-option">
                <input type="checkbox" name="artworkCategory[]" value="Other" onchange="updateSelectedCategories()"> Other
            </label>
        </div>
    </div>

    <div class="form-error" id="categoryError"></div>
</div>

        <button 
    type="submit" 
    class="seller-submit-btn {{#if alreadyRegistered}}enrolled-btn{{/if}}"
    {{#if alreadyRegistered}}disabled{{/if}}
>
    {{#if alreadyRegistered}}
        Already Enrolled
    {{else}}
        Complete Registration
    {{/if}}
</button>


        </form>
    </div>
</main>

<style>
/* Artender Theme Card */
.comingsoon-wrapper{
    background:#ffffff;
    max-width:700px;
    margin:auto;
    overflow: visible;
    padding:42px;
    border-radius:20px;
    box-shadow:0 12px 45px rgba(249,115,22,0.15);
    font-family:'Noto Sans',sans-serif;
    border:1px solid #ffedd5;
}

/* Titles */
.comingsoon-title{
    color:#1f2937;
    font-weight:700;
}

.comingsoon-subtitle{
    color:#6b7280;
    margin-bottom:25px;
}

/* Form */
.form-group{margin-bottom:22px}

.form-label{
    font-weight:600;
    margin-bottom:8px;
    display:block;
    color:#1f2937;
}

.form-input,.form-textarea{
    width:100%;
    padding:14px;
    border:2px solid #fed7aa;
    border-radius:14px;
    background:#fff7ed;
    font-size:15px;
    transition:all .25s ease;
}
/* Multi Select Dropdown */
.multi-select-dropdown {
    position: relative;
    width: 100%;
    user-select: none;
}

.dropdown-header {
    padding: 14px;
    border: 2px solid #fed7aa;
    border-radius: 14px;
    background: #fff7ed;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    transition: all .25s ease;
}

.dropdown-header:hover {
    border-color: #f97316;
    background: #ffffff;
}

.dropdown-options {
    display: none;
    position: absolute;
    width: 100%;
    background: white;
    border: 1.5px solid #fed7aa;
    border-radius: 14px;
    margin-top: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    max-height: 240px;
    overflow-y: auto;
    z-index: 50;   /* 🔥 FIX */
}


.dropdown-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    cursor: pointer;
    font-size: 14px;
}

.dropdown-option:hover {
    background: #fff7ed;
}

.dropdown-option input {
    accent-color: #f97316;
    transform: scale(1.2);
}

.dropdown-arrow {
    font-size: 12px;
    transition: transform .3s ease;
}

.dropdown-open .dropdown-options {
    display: block;
}

.dropdown-open .dropdown-arrow {
    transform: rotate(180deg);
}

.form-input:focus,.form-textarea:focus{
    outline:none;
    border-color:#f97316;
    background:#ffffff;
    box-shadow:0 0 0 4px rgba(249,115,22,0.15);
}

.form-error{
    color:#dc2626;
    font-size:14px;
    margin-top:5px;
}

/* Checkbox UI */
.checkbox-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:12px;
    margin-top:10px;
}

.checkbox-item{
    display:flex;
    align-items:center;
    gap:8px;
    border:1.5px solid #fed7aa;
    padding:10px 12px;
    border-radius:12px;
    background:#fff7ed;
    cursor:pointer;
    transition:all .25s ease;
    font-size:14px;
}

.checkbox-item:hover{
    border-color:#f97316;
    background:#ffffff;
}

.checkbox-item input{
    accent-color:#f97316;
    transform:scale(1.2);
}

/* Orange Artender Button */
.seller-submit-btn{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    background:#f97316;
    color:#ffffff;
    font-size:17px;
    font-weight:600;
    cursor:pointer;
    margin-top:14px;
    transition:all .3s ease;
    box-shadow:0 8px 20px rgba(249,115,22,0.35);
}

.seller-submit-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 12px 28px rgba(249,115,22,0.45);
}
    /* Success banner */
.enrolled-banner{
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #6ee7b7;
    padding: 14px 18px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-weight: 600;
    text-align: center;
}

/* Different button when enrolled */
.enrolled-btn{
    background: #9ca3af !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
}

.enrolled-btn:hover{
    transform: none !important;
    box-shadow: none !important;
}

</style>


