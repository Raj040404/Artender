<style>
.comingsoon-main {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: linear-gradient(135deg, #fff7ed, #f0fff4);
    position: relative;
    overflow: hidden;
}

/* Card */
.comingsoon-wrapper {
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 50px 35px;
    border-radius: 24px;
    background: white;
    box-shadow: 0 12px 45px rgba(0, 0, 0, 0.08);
    max-width: 720px;
    width: 100%;
    overflow: hidden;
}

/* Title */
.comingsoon-title {
    font-family: 'STIX Two Text', serif;
    font-size: 60px;
    margin-bottom: 18px;
    letter-spacing: 1px;
    background: linear-gradient(90deg, #ff7a00, #14532d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* Subtitle */
.comingsoon-subtitle {
    font-family: 'Noto Sans', sans-serif;
    font-size: 19px;
    color: #14532d;
    line-height: 1.8;
}

/* Artistic paint blobs */
.paint-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
    z-index: 1;
}

.blob1 {
    width: 220px;
    height: 220px;
    background: #ff7a00;
    top: -60px;
    left: -60px;
}

.blob2 {
    width: 200px;
    height: 200px;
    background: #14532d;
    bottom: -70px;
    right: -60px;
}

.blob3 {
    width: 160px;
    height: 160px;
    background: #ffb347;
    top: 50%;
    left: 80%;
    transform: translate(-50%, -50%);
}

/* Brush underline */
.brush-line {
    margin: 28px auto 0;
    width: 140px;
    height: 6px;
    background: linear-gradient(90deg, #ff7a00, #14532d);
    border-radius: 10px;
}

/* Responsive */
@media (max-width: 768px) {
    .comingsoon-title {
        font-size: 40px;
    }

    .comingsoon-wrapper {
        padding: 35px 20px;
    }
}
</style>



