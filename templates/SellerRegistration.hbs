            border-left: 3px solid rgba(255, 152, 0, 0.4);
        }
        
        .msg-corner-tr {
            top: 15px;
            right: 15px;
            border-top: 3px solid rgba(46, 125, 50, 0.4);
            border-right: 3px solid rgba(46, 125, 50, 0.4);
        }
        
        .msg-corner-bl {
            bottom: 15px;
            left: 15px;
            border-bottom: 3px solid rgba(46, 125, 50, 0.4);
            border-left: 3px solid rgba(46, 125, 50, 0.4);
        }
        
        .msg-corner-br {
            bottom: 15px;
            right: 15px;
            border-bottom: 3px solid rgba(255, 152, 0, 0.4);
            border-right: 3px solid rgba(255, 152, 0, 0.4);
        }
        
        /* Decorative dots around the page */
        .decorative-dot {
            position: absolute;
            border-radius: 50%;
            z-index: 2;
            animation: dot-pulse 4s infinite;
        }
        
        .dot-orange {
            background: #FF9800;
            width: 8px;
            height: 8px;
            top: 20%;
            left: 5%;
            animation-delay: 0s;
        }
        
        .dot-green {
            background: #2E7D32;
            width: 10px;
            height: 10px;
            top: 15%;
            right: 10%;
            animation-delay: 0.5s;
        }
        
        .dot-orange-large {
            background: rgba(255, 152, 0, 0.6);
            width: 12px;
            height: 12px;
            bottom: 25%;
            left: 15%;
            animation-delay: 1s;
        }
        
        .dot-green-large {
            background: rgba(46, 125, 50, 0.6);
            width: 14px;
            height: 14px;
            bottom: 35%;
            right: 5%;
            animation-delay: 1.5s;
        }
        
        @keyframes dot-pulse {
            0%, 100% { transform: scale(1); opacity: 0.7; }
            50% { transform: scale(1.3); opacity: 1; }
        }
        
        /* Footer styles from reference */
        .footer {
            width: 100%;
            padding: 2rem;
            text-align: center;
            background: white;
            border-top: 1px solid #eee;
            margin-top: auto;
        }
        
        /* Responsive adjustments */
        @media (max-width: 1024px) {
            .main-title { font-size: 6rem; }
            .message-box { padding: 45px 55px; max-width: 800px; }
