<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Registration - Coming Soon</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Raleway:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #FFFEF0 0%, #FFF9E6 100%);
            font-family: 'Raleway', sans-serif;
            overflow: hidden;
            position: relative;
        }

        .container {
            text-align: center;
            position: relative;
            z-index: 10;
            padding: 60px 40px;
            max-width: 1200px;
        }

        /* Artistic background visuals */
        .art-bg {
            position: absolute;
            z-index: 1;
            pointer-events: none;
        }

        /* Watercolor splashes */
        .splash-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            left: -150px;
            background: radial-gradient(circle, rgba(255, 152, 0, 0.1) 0%, transparent 70%);
            filter: blur(30px);
            border-radius: 50%;
            animation: gentle-pulse 8s infinite alternate;
        }

        .splash-2 {
            width: 350px;
            height: 350px;
            bottom: -100px;
            right: -100px;
            background: radial-gradient(circle, rgba(46, 125, 50, 0.08) 0%, transparent 70%);
            filter: blur(25px);
            border-radius: 50%;
            animation: gentle-pulse 10s infinite alternate-reverse;
        }

        .splash-3 {
            width: 250px;
            height: 250px;
            top: 30%;
            right: 10%;
            background: radial-gradient(circle, rgba(255, 193, 7, 0.07) 0%, transparent 70%);
            filter: blur(20px);
            border-radius: 50%;
            animation: gentle-pulse 12s infinite alternate;
        }

        @keyframes gentle-pulse {
            0% { transform: scale(1); opacity: 0.5; }
            100% { transform: scale(1.2); opacity: 0.8; }
        }

        /* Geometric patterns */
        .geometric {
            position: absolute;
            opacity: 0.03;
            z-index: 1;
        }

        .geo-1 {
            width: 200px;
            height: 200px;
            top: 15%;
            left: 10%;
            background: linear-gradient(45deg, transparent 49.5%, #FF9800 49.5%, #FF9800 50.5%, transparent 50.5%);
            animation: rotate-slow 60s infinite linear;
        }

        .geo-2 {
            width: 150px;
            height: 150px;
            bottom: 20%;
            right: 15%;
            background: linear-gradient(45deg, transparent 49.5%, #2E7D32 49.5%, #2E7D32 50.5%, transparent 50.5%);
            animation: rotate-slow 40s infinite linear reverse;
        }

        .geo-3 {
            width: 100px;
            height: 100px;
            top: 60%;
            left: 20%;
            background: repeating-linear-gradient(45deg, transparent, transparent 5px, #FF9800 5px, #FF9800 10px);
            animation: rotate-slow 30s infinite linear;
        }

        @keyframes rotate-slow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Brush stroke elements */
        .brush-stroke {
            position: absolute;
            background: linear-gradient(90deg, transparent, rgba(255, 152, 0, 0.1), transparent);
            z-index: 1;
            opacity: 0.4;
            filter: blur(1px);
        }

        .stroke-1 {
            width: 300px;
            height: 10px;
            top: 25%;
            left: -100px;
            transform: rotate(45deg);
            animation: stroke-move 25s infinite linear;
        }

        .stroke-2 {
            width: 250px;
            height: 8px;
            bottom: 30%;
            right: -80px;
            transform: rotate(-30deg);
            background: linear-gradient(90deg, transparent, rgba(46, 125, 50, 0.1), transparent);
            animation: stroke-move 20s infinite linear reverse;
        }

        @keyframes stroke-move {
            0% { transform: translateX(-100px) rotate(45deg); }
            100% { transform: translateX(calc(100vw + 200px)) rotate(45deg); }
        }

        /* Decorative corner leaves */
        .leaf {
            position: absolute;
            font-size: 2.8rem;
            z-index: 2;
            opacity: 0.3;
        }

        .leaf-tl {
            top: 30px;
            left: 30px;
            transform: rotate(-45deg);
            color: #FF9800;
        }

        .leaf-tr {
            top: 30px;
            right: 30px;
            transform: rotate(45deg);
            color: #2E7D32;
        }

        .leaf-bl {
            bottom: 30px;
            left: 30px;
            transform: rotate(-135deg);
            color: #FF9800;
        }

        .leaf-br {
            bottom: 30px;
            right: 30px;
            transform: rotate(135deg);
            color: #2E7D32;
        }

        /* Main text styling */
        .main-title {
            font-family: 'Playfair Display', serif;
            font-size: 7.5rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 40px;
            position: relative;
            display: inline-block;
        }

        .coming-text {
            color: #FF9800;
            text-shadow: 4px 4px 0px rgba(255, 152, 0, 0.15);
            letter-spacing: 4px;
            position: relative;
            display: inline-block;
        }

        .soon-text {
            color: #2E7D32;
            text-shadow: 4px 4px 0px rgba(46, 125, 50, 0.15);
            letter-spacing: 4px;
            position: relative;
            display: inline-block;
        }

        /* Animated underline */
        .title-underline {
            width: 250px;
            height: 5px;
            background: linear-gradient(90deg, #FF9800, #2E7D32, #FF9800);
            margin: 25px auto 45px;
            position: relative;
            overflow: hidden;
            border-radius: 3px;
        }

        .title-underline::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
            animation: underline-shine 3s infinite;
        }

        @keyframes underline-shine {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        /* Message box styling */
        .message-box {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 25px;
            padding: 55px 65px;
            max-width: 900px;
            margin: 0 auto;
            box-shadow: 
                0 20px 40px rgba(255, 152, 0, 0.08),
                0 8px 20px rgba(46, 125, 50, 0.08),
                inset 0 1px 0 rgba(255, 255, 255, 0.9);
            border: 2px solid rgba(255, 152, 0, 0.1);
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .message-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #FF9800, #2E7D32);
        }

        .message-text {
            font-size: 1.45rem;
            line-height: 1.85;
            color: #4A4A4A;
            font-weight: 300;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 2;
        }

        .message-text strong {
            color: #2E7D32;
            font-weight: 500;
        }

        /* Decorative message corners - orange and green */
        .message-corner {
            position: absolute;
            width: 35px;
            height: 35px;
            z-index: 1;
        }

        .msg-corner-tl {
            top: 15px;
            left: 15px;
            border-top: 3px solid rgba(255, 152, 0, 0.4);
            border-left: 3px solid rgba(255, 152, 0, 0.4);
        }

        .msg-corner-tr {
            top: 15px;
            right: 15px;
            border-top: 3px solid rgba(46, 125, 50, 0.4);
            border-right: 3px solid rgba(46, 125, 50, 0.4);
        }

        .msg-corner-bl {
            bottom: 15px;
            left: 15px;
            border-bottom: 3px solid rgba(46, 125, 50, 0.4);
            border-left: 3px solid rgba(46, 125, 50, 0.4);
        }

        .msg-corner-br {
            bottom: 15px;
            right: 15px;
            border-bottom: 3px solid rgba(255, 152, 0, 0.4);
            border-right: 3px solid rgba(255, 152, 0, 0.4);
        }

        /* Decorative dots around the page */
        .decorative-dot {
            position: absolute;
            border-radius: 50%;
            z-index: 2;
            animation: dot-pulse 4s infinite;
        }

        .dot-orange {
            background: #FF9800;
            width: 8px;
            height: 8px;
            top: 20%;
            left: 5%;
            animation-delay: 0s;
        }

        .dot-green {
            background: #2E7D32;
            width: 10px;
            height: 10px;
            top: 15%;
            right: 10%;
            animation-delay: 0.5s;
        }

        .dot-orange-large {
            background: rgba(255, 152, 0, 0.6);
            width: 12px;
            height: 12px;
            bottom: 25%;
            left: 15%;
            animation-delay: 1s;
        }

        .dot-green-large {
            background: rgba(46, 125, 50, 0.6);
            width: 14px;
            height: 14px;
            bottom: 35%;
            right: 5%;
            animation-delay: 1.5s;
        }

        @keyframes dot-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.7;
            }
            50% {
                transform: scale(1.3);
                opacity: 1;
            }
        }

        /* Responsive adjustments */
        @media (max-width: 1024px) {
            .main-title {
                font-size: 6rem;
            }
            
            .message-box {
                padding: 45px 55px;
                max-width: 800px;
            }
            
            .message-text {
                font-size: 1.35rem;
            }
        }

        @media (max-width: 768px) {
            .main-title {
                font-size: 4.5rem;
            }
            
            .message-box {
                padding: 35px 45px;
                max-width: 90%;
            }
            
            .message-text {
                font-size: 1.2rem;
                line-height: 1.7;
            }
            
            .splash-1, .splash-2, .splash-3 {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .main-title {
                font-size: 3.2rem;
            }
            
            .container {
                padding: 30px 20px;
            }
            
            .message-box {
                padding: 30px 35px;
            }
            
            .message-text {
                font-size: 1.1rem;
            }
            
            .leaf {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <!-- Artistic background elements -->
    <div class="art-bg splash-1"></div>
    <div class="art-bg splash-2"></div>
    <div class="art-bg splash-3"></div>
    
    <div class="geometric geo-1"></div>
    <div class="geometric geo-2"></div>
    <div class="geometric geo-3"></div>
    
    <div class="brush-stroke stroke-1"></div>
    <div class="brush-stroke stroke-2"></div>
    
    <!-- Decorative leaves -->
    <div class="leaf leaf-tl">❧</div>
    <div class="leaf leaf-tr">❧</div>
    <div class="leaf leaf-bl">❧</div>
    <div class="leaf leaf-br">❧</div>
    
    <!-- Decorative dots -->
    <div class="decorative-dot dot-orange"></div>
    <div class="decorative-dot dot-green"></div>
    <div class="decorative-dot dot-orange-large"></div>
    <div class="decorative-dot dot-green-large"></div>
    
    <div class="container">
        <h1 class="main-title">
            <span class="coming-text">COMING</span><br>
            <span class="soon-text">SOON</span>
        </h1>
        
        <div class="title-underline"></div>
        
        <div class="message-box">
            <div class="message-corner msg-corner-tl"></div>
            <div class="message-corner msg-corner-tr"></div>
            <div class="message-corner msg-corner-bl"></div>
            <div class="message-corner msg-corner-br"></div>
            
            <p class="message-text">
                <strong>We're building an incredible platform for sellers</strong> to showcase their products, reach millions of customers, 
                and grow their business like never before. Get ready for a seamless selling experience with powerful tools 
                designed to help you succeed.
            </p>
        </div>
    </div>

    <script>
        // Add subtle hover effects without floating
        document.querySelector('.main-title').addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-5px)';
            this.style.transition = 'transform 0.3s ease';
        });
        
        document.querySelector('.main-title').addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
        });
        
        // Add subtle message box hover effect
        document.querySelector('.message-box').addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.01)';
            this.style.boxShadow = '0 25px 50px rgba(255, 152, 0, 0.12), 0 10px 25px rgba(46, 125, 50, 0.12)';
            this.style.transition = 'all 0.3s ease';
        });
        
        document.querySelector('.message-box').addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1)';
            this.style.boxShadow = '0 20px 40px rgba(255, 152, 0, 0.08), 0 8px 20px rgba(46, 125, 50, 0.08)';
        });
        
        // Color accent animation on text
        const comingText = document.querySelector('.coming-text');
        const soonText = document.querySelector('.soon-text');
        
        setInterval(() => {
            comingText.style.textShadow = `4px 4px 0px rgba(255, 152, 0, ${0.1 + Math.random() * 0.15})`;
            soonText.style.textShadow = `4px 4px 0px rgba(46, 125, 50, ${0.1 + Math.random() * 0.15})`;
        }, 2000);
    </script>
</body>
</html>
