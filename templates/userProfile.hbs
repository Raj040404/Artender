<main>
  <h1>{{name}}'s Profile</h1>

  <!-- ✅ User Info Section -->
  <div class="user-info">
    {{#if profilePicture}}
    <img src="data:image/jpeg;base64,{{profilePicture}}" alt="Profile Picture" />
    {{else}}
    <div class="no-image">No profile picture</div>
    {{/if}}
    <div class="details">
      <p><strong>Bio:</strong> {{bio}}</p>
      <p><strong>Followers:</strong> {{followers}}</p>
      <p><strong>Location:</strong> {{location}}</p>
    </div>
  </div>

  <!-- ✅ User Posts Section -->
  <section id="userPosts" class="user-posts">
    {{#if posts.length}}
    {{#each posts}}
    <div class="post-item">
      <p>{{this.description}}</p>
      {{#if this.file}}
      {{#if (startsWith this.fileType "image/")}}
      <div class="post-media">
        <img class="post-image" src="data:{{this.fileType}};base64,{{this.file}}" alt="Post Image" />
      </div>
      {{else if (startsWith this.fileType "video/")}}
      <div class="post-media">
        <video class="post-video" controls>
          <source src="data:{{this.fileType}};base64,{{this.file}}" type="{{this.fileType}}" />
          Your browser does not support the video tag.
        </video>
      </div>
      {{/if}}
      {{/if}}
      <div class="post-content">
        <div class="like-container">
          <button class="like-button {{#if isLiked}}liked{{/if}}" data-username="{{username}}"
            data-post-no="{{postNo}}">
            <span class="button-text">{{#if isLiked}}Liked{{else}}Like{{/if}}</span>
            (<span class="like-count">{{likeCount}}</span>)
          </button>
        </div>
      </div>
    </div>
    </div>
    {{/each}}
    {{else}}
    <p>No posts to show.</p>
    {{/if}}
  </section>
</main>

