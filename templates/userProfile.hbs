<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{name}}'s Profile</title>
  <link rel="stylesheet" href="/css/userprofile.css">
</head>

<body>
  <header>
    <div class="logo">
      <a href="/home" style="text-decoration: none; color: inherit;">Artender</a>
    </div>
    <nav>
      <a href="/home">home</a>
      <a href="/explorecompetitions">Explore works</a>
      <a href="/competitions">Participate in Competitions</a>
      <a href="#">Contact</a>
      <a href="/profile">Profile</a>
    </nav>
    <div class="logout">
      <form action="/logout" method="get">
        <button class="logout-button" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <main>
    <h1>{{name}}'s Profile</h1>
    <div class="profile-card">
      {{#if profilePicture}}
      <img src="data:image/png;base64,{{profilePicture}}" alt="{{name}}'s Profile Picture" />
      {{else}}
      <p>No profile picture available.</p>
      {{/if}}
      <p><strong>Bio:</strong> {{bio}}</p>
      <p><strong>Followers:</strong> {{followers}}</p>
      <p><strong>Location:</strong> {{location}}</p>
    </div>

    <section id="userPosts">
      <h3>Posts by {{name}}</h3>
      {{#if posts.length}}
      {{#each posts}}
      <div class="post-card">
        <p>{{this.description}}</p>
        {{#if this.file}}
        {{#if (startsWith this.fileType "image/")}}
        <img src="data:{{this.fileType}};base64,{{this.file}}" alt="Post Image" />
        {{else if (startsWith this.fileType "video/")}}
        <video controls>
          <source src="data:{{this.fileType}};base64,{{this.file}}" type="{{this.fileType}}" />
          Your browser does not support the video tag.
        </video>
        {{/if}}
        {{/if}}
        <small>Posted on: {{this.createdAt}}</small>
        <button class="like-button" data-username="{{username}}" data-post-no="{{postNo}}" style="font-size: 14px;">
          Like (<span class="like-count">{{this.likes.length}}</span>)
        </button>

      </div>
      {{/each}}
      {{else}}
      <p>No posts to show.</p>
      {{/if}}
    </section>
  </main>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const likeButtons = document.querySelectorAll(".like-button");

      likeButtons.forEach((button) => {
        const username = button.getAttribute("data-username");
        const postNo = button.getAttribute("data-post-no");

        button.addEventListener("click", async () => {

          if (!username || !postNo) {
            console.error("Missing username or postNo for like button.");
            return;
          }

          try {
            const response = await fetch("/like", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ username, postNo }),
            });

            if (response.ok) {
              const data = await response.json();
              button.classList.add("liked");
              button.querySelector(".like-count").textContent = data.likes;
              button.textContent = `Liked (${data.likes})`;
            } else {
              const errorMessage = await response.text();
              alert(`Failed to like the post: ${errorMessage}`);
            }
          } catch (error) {
            console.error("Error liking the post:", error);
          }
        });
      });
    });
  </script>

</body>

</html>