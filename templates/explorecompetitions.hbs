        </nav>
      </div>
    </div>
  </div>
  <main>
    <h1 class="heading">Explore Artworks</h1>

    <!-- Search Form -->
    <form class="search-form" id="searchForm" action="/search" method="GET">
      <input type="text" name="query" placeholder="Search users by name..." required>
      <button type="submit">Search</button>
    </form>

    <!-- Search Results -->
    <section id="searchResults">
      {{#if users}}
      <h2>Search Results</h2>
      {{#each users}}
      <article class="gallery-item">
        <h3><a href="/user/{{name}}">{{name}}</a></h3>
        <p>{{bio}}</p>
        <button class="followBtn" data-username="{{name}}" data-followed="{{isFollowed}}">
          {{#if isFollowed}}Followed{{else}}Follow{{/if}}
        </button>
      </article>
      {{/each}}
      {{else}}
      {{/if}}
    </section>

    <div class="post-your-work">
      <button id="postYourWorkBtn">Post Your Work</button>
    </div>

    <!-- Post Your Work Form -->
    <div id="postYourWorkForm" class="post-form">
      <form action="/publish" method="POST" enctype="multipart/form-data">
        <label for="description">Description:</label><br>
        <textarea id="description" name="description" rows="4" cols="50" required></textarea><br>
        <label for="file">Upload Image/Video:</label><br>
        <input type="file" id="file" name="file" accept="image/*" required><br><br>

        <!-- Image Preview and Cropping Area -->
        <div id="imagePreview" style="display: none; margin-top: 10px;">
          <img id="imageToCrop" style="max-width: 100%; max-height: 400px;" />
          <div style="margin-top: 10px;">
            <button
              type="button"
              id="cropImageBtn"
              style="background:#3399cc;color:#fff;border:none;padding:8px 18px;border-radius:5px;cursor:pointer;font-size:15px;margin-right:10px;transition:background 0.2s;"
              onmouseover="this.style.background='#267399'"
              onmouseout="this.style.background='#3399cc'"
            >
              Crop Image
            </button>
            <button
              type="button"
              id="resetCropBtn"
              style="background:#ef7777;color:#333;border:none;padding:8px 18px;border-radius:5px;cursor:pointer;font-size:15px;transition:background 0.2s;"
              onmouseover="this.style.background='#ccc'"
              onmouseout="this.style.background='#eee'"
            >
              Reset
            </button>
          </div>
        </div>
        <!-- Hidden input to store cropped image data -->
        <input type="hidden" id="croppedImageData" name="croppedImageData" />

        <button type="submit" id="publishBtn">Publish</button>
        <button type="button" id="cancelFormBtn">Cancel</button>
      </form>
    </div>

    <!-- Competition Posts -->
    <section id="competitionPosts" class="gallery">
      {{#each posts}}
      <article class="gallery-item">
        <div class="user-info">
          <img src="{{profilePicture}}" alt="Profile Picture" class="small-profile-pic" />
          <h2><strong><a href="/user/{{username}}">{{username}}</a></strong></h2>
        </div>
        <div class="post-media">
          {{#if file}}
          {{#if (startsWith fileType "image/")}}
          <img src="data:{{fileType}};base64,{{file}}" alt="Uploaded Image" class="post-image" />
          {{else if (startsWith fileType "video/")}}
          <video controls class="post-video">
            <source src="data:{{fileType}};base64,{{file}}" type="{{fileType}}" />
            Your browser does not support the video tag.
          </video>
          {{/if}}
          {{/if}}
        </div>
        <div class="post-content">
          <h3>{{this.title}}</h3>
          <p>{{this.description}}</p>
        </div>
        <!-- Like button always at the bottom -->
        <div class="like-container">
          <button class="like-button {{#if isLiked}}liked{{/if}}" data-username="{{username}}"
            data-post-no="{{postNo}}">
            <span class="button-text">{{#if isLiked}}Liked{{else}}Like{{/if}}</span>
            (<span class="like-count">{{likeCount}}</span>)
          </button>
        </div>
      </article>
      {{/each}}



    </section>
  </main>
  <footer4-wrapper class="footer4-wrapper">
    <!--Footer4 component-->
    <footer class="footer4-footer7 thq-section-padding">
      <div class="footer4-max-width thq-section-max-width">
        <div class="footer4-content">
          <div class="footer4-logo1">
            <img alt="Logo" src="/logo/WhatsApp Image 2025-02-23 at 00.10.41_0364758d.jpg" class="footer4-logo2" />
          </div>
        </div>
        <div id="Logout-buttons1" class="navbar8-buttons1">
          <a href="/logout" target="_blank">
            <button class="navbar8-action11 thq-button-animated thq-button-filled">
              <span>
                <fragment class="landing-fragment101">
                  <span class="landing-text101">Logout</span>
                </fragment>
              </span>
            </button>
          </a>
        </div>
      </div>

    </footer>
  </footer4-wrapper>

  <script>
    let cropper;

    // Initialize page functionality
    document.addEventListener("DOMContentLoaded", () => {
      // Toggle Post Your Work Form
      const postYourWorkBtn = document.getElementById("postYourWorkBtn");
      const postForm = document.getElementById("postYourWorkForm");
      const cancelFormBtn = document.getElementById("cancelFormBtn");

      postYourWorkBtn.addEventListener("click", () => {
        postForm.style.display = postForm.style.display === "block" ? "none" : "block";
      });

      cancelFormBtn.addEventListener("click", () => {
        postForm.style.display = "none";
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
        document.getElementById("imagePreview").style.display = "none";
      });

      // Handle Image Upload and Cropping
      const fileInput = document.getElementById("file");
      fileInput.addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (file && file.type.startsWith("image/")) {
          const reader = new FileReader();
          reader.onload = function (event) {
            const img = document.getElementById("imageToCrop");
            img.src = event.target.result;
            document.getElementById("imagePreview").style.display = "block";

            if (cropper) {
              cropper.destroy();
            }

            // Initialize Cropper.js with original image size and freeform cropping
            cropper = new Cropper(img, {
              viewMode: 1, // Restrict crop box to image bounds
              autoCropArea: 0.8, // Start with 80% of image area selected
              responsive: true,
              // No aspectRatio: allows freeform cropping
              // No fixed width/height: uses original image dimensions
            });
          };
          reader.readAsDataURL(file);
        }
      });

      // Crop Image Button
      document.getElementById("cropImageBtn").addEventListener("click", function () {
        if (cropper) {
          // Get cropped canvas without fixed dimensions
          const canvas = cropper.getCroppedCanvas(); // Uses user-defined crop area
          const croppedImageData = canvas.toDataURL("image/jpeg");
          document.getElementById("croppedImageData").value = croppedImageData;
          document.getElementById("imageToCrop").src = croppedImageData;
          cropper.destroy();
          cropper = null;
        }
      });

      // Reset Crop Button
      document.getElementById("resetCropBtn").addEventListener("click", function () {
        if (cropper) {
          cropper.reset();
        }
      });

      // Form Submission - Prevent if cropper is active
      document.querySelector("#postYourWorkForm form").addEventListener("submit", function (e) {
        if (cropper) {
          e.preventDefault();
          alert("Please crop the image before submitting.");
        }
      });

      // Cooldown logic for Publish button
      const publishBtn = document.getElementById("publishBtn");
      let publishCooldown = false;

      document.querySelector("#postYourWorkForm form").addEventListener("submit", function (e) {
        if (publishCooldown) {
          e.preventDefault();
          alert("Please wait before posting again.");
          return;
        }
        // Disable button and start cooldown
        publishBtn.disabled = true;
        publishBtn.textContent = "Please wait...";
        publishCooldown = true;

        setTimeout(() => {
          publishBtn.disabled = false;
          publishBtn.textContent = "Publish";
          publishCooldown = false;
        }, 10000); // 10 seconds
      });

      // Like Button Functionality
      const likeButtons = document.querySelectorAll(".like-button");
      likeButtons.forEach((button) => {
        const username = button.getAttribute("data-username");
        const postNo = button.getAttribute("data-post-no");

        button.addEventListener("click", async () => {
          try {
            const response = await fetch("/like", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ username, postNo }),
            });

            if (response.ok) {
              const data = await response.json();
              const buttonText = button.querySelector(".button-text");
              const likeCount = button.querySelector(".like-count");

              if (data.isLiked) {
                button.classList.add("liked");
                buttonText.textContent = "Liked";
              } else {
                button.classList.remove("liked");
                buttonText.textContent = "Like";
              }
              likeCount.textContent = data.likes;
            } else {
              console.error("Failed to like the post.");
            }
          } catch (error) {
            console.error("Error liking the post:", error);
          }
        });
      });
    });

    // Toggle Navbar
    function toggleNavbar() {
      const navbarMenu = document.getElementById("navbarMenu");
      navbarMenu.style.display = navbarMenu.style.display === "flex" ? "none" : "flex";
    }

    // Disable Screenshots and Developer Tools
    document.addEventListener("keydown", function (e) {
      if (e.ctrlKey && e.shiftKey && e.key === "s") {
        e.preventDefault();
        alert("Screenshots are disabled!");
      } else if (e.key === "PrintScreen") {
        e.preventDefault();
        alert("Screenshots are disabled!");
      } else if (e.ctrlKey && ["u", "U", "i", "I"].includes(e.key)) {
        e.preventDefault();
        alert("View Source and Inspect Element are disabled!");
      }
    });
  </script>
</body>

</html>
