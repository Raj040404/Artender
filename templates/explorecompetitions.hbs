<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore Artworks</title>
  <link rel="stylesheet" href="/css/explore.css">
</head>

<body>
  <header>
    <div class="logo">
      <a href="/home" style="text-decoration: none; color: inherit;">Artender</a>
    </div>
    <nav>
      <a href="/home">Home</a>
      <a href="/explorecompetitions">Explore Art</a>
      <a href="/competitions">Participate in Competitions</a>
      <a href="#">Contact</a>
      <a href="/profile">Profile</a>
    </nav>
    <div class="logout">
      <form action="/logout" method="get">
        <button class="logout-button" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <main>
    <h1>Explore Artworks</h1>

    <!-- Search Form -->
    <form class="search-form" id="searchForm" action="/search" method="GET">
      <input type="text" name="query" placeholder="Search users by name..." required>
      <button type="submit">Search</button>
    </form>

    <!-- Search Results -->
    <section id="searchResults">
      {{#if users}}
      <h2>Search Results</h2>
      {{#each users}}
      <article class="gallery-item">
        <h3><a href="/user/{{name}}">{{name}}</a></h3>
        <p>{{bio}}</p>
        <button class="followBtn" data-username="{{name}}" data-followed="{{isFollowed}}">
          {{#if isFollowed}}Followed{{else}}Follow{{/if}}
        </button>
      </article>
      {{/each}}
      {{else}}
      {{/if}}
    </section>

    <!-- Post Your Work Button -->
    <div class="post-your-work">
      <button id="postYourWorkBtn">Post Your Work</button>
    </div>

    <!-- Post Your Work Form -->
    <div id="postYourWorkForm" class="post-form">
      <form action="/publish" method="POST" enctype="multipart/form-data">
        <label for="description">Description:</label><br>
        <textarea id="description" name="description" rows="4" cols="50" required></textarea><br>
        <label for="file">Upload Image/Video:</label><br>
        <input type="file" id="file" name="file" accept="image/*,video/*" required><br><br>
        <button type="submit">Publish</button>
        <button type="button" id="cancelFormBtn">Cancel</button>
      </form>
    </div>

    <!-- Competition Posts -->
    <section id="competitionPosts" class="gallery">
      {{#each posts}}
      <article class="gallery-item">
        <div class="user-info">
          <!-- Show profile picture with proper size -->
          <img src="{{profilePicture}}" alt="Profile Picture" class="small-profile-pic" />

          <!-- Display username -->
          <h2>
            <strong><a href="/user/{{username}}">{{username}}</a></strong>
          </h2>
        </div>

        <!-- Conditional rendering for uploaded files -->
        {{#if file}}
        {{#if (startsWith fileType "image/")}}
        <img src="data:{{fileType}};base64,{{file}}" alt="Uploaded Image" />
        {{else if (startsWith fileType "video/")}}
        <video controls>
          <source src="data:{{fileType}};base64,{{file}}" type="{{fileType}}" />
          Your browser does not support the video tag.
        </video>
        {{/if}}
        {{/if}}

        <!-- Post Content -->
        <div class="post">
          <h3>{{this.title}}</h3>
          <p>{{this.description}}</p>

          <!-- Post Image (if any) -->
          {{#if this.image}}
          <img src="{{this.image}}" alt="Post Image" />
          {{/if}}

          <!-- Like Button inside a post -->
          <button class="like-button" data-username="{{username}}" data-post-no="{{postNo}}" style="font-size: 14px;">
            Like (<span class="like-count">{{this.likes.length}}</span>)
          </button>

        </div>
      </article>
      {{/each}}
    </section>
  </main>

  <script>

    // Toggle Post Your Work Form
    document.getElementById('postYourWorkBtn').addEventListener('click', () => {
      document.getElementById('postYourWorkForm').style.display = 'block';
    });

    document.getElementById('cancelFormBtn').addEventListener('click', () => {
      document.getElementById('postYourWorkForm').style.display = 'none';
    });

    // Like Button Functionality
    document.addEventListener("DOMContentLoaded", () => {
      const likeButtons = document.querySelectorAll(".like-button");

      likeButtons.forEach((button) => {
        const username = button.getAttribute("data-username");
        const postNo = button.getAttribute("data-post-no");

        button.addEventListener("click", async () => {

          if (!username || !postNo) {
            console.error("Missing username or postNo for like button.");
            return;
          }

          try {
            const response = await fetch("/like", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ username, postNo }),
            });

            if (response.ok) {
              const data = await response.json();
              button.classList.add("liked");
              button.querySelector(".like-count").textContent = data.likes;
              button.textContent = `Liked (${data.likes})`;
            } else {
              const errorMessage = await response.text();
              alert(`Failed to like the post: ${errorMessage}`);
            }
          } catch (error) {
            console.error("Error liking the post:", error);
          }
        });
      });
    });

  </script>
</body>

</html>