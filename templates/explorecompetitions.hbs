      </navbar8-wrapper>
      <div class="navbar-toggle" onclick="toggleNavbar()">
        <img src="/navigation-aligned-dots-more-horizontal-three-dots-option-icon-svgrepo-com.svg" alt="Menu"
          class="navbar-toggle-icon">
      </div>

      <div id="navbarMenu" class="navbar-menu">
        <nav class="navbar-menu-links">
          <a href="/home" class="navbar-menu-link">Home</a>
          <a href="/competitions" class="navbar-menu-link">Participate in Competitions</a>
          <a href="/profile" class="navbar-menu-link">Profile</a>
