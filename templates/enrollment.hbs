  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var alreadyEnrolled = {{#if alreadyEnrolled}}true{{else}}false{{/if}};
      if (alreadyEnrolled) {
        document.getElementById('enrollButton').disabled = true;
        document.getElementById('popupMessage').style.display = 'block';
        document.getElementById('enrollButton').textContent = 'Already Enrolled';
      }

      document.getElementById('enrollButton').onclick = async function (e) {
        e.preventDefault();
        if (alreadyEnrolled) return;

        const contestId = "{{contest.contestId}}";
        const phone = document.getElementById('phone').value.trim();

        // Validate phone number (10 digits)
        if (!/^\d{10}$/.test(phone)) {
          alert("Please enter a valid 10-digit phone number.");
          document.getElementById('phone').focus();
          return;
        }

        // 1. Create FormData to send file and other details
        const form = document.getElementById('enrollmentForm');
        const formData = new FormData(form);

        // Ensure phone and contestId are in formData
        formData.set('phone', phone);
        formData.set('contestId', contestId);

        // 2. Create PhonePe payment order (which also handles enrollment)
        let orderData;
        try {
          const orderRes = await fetch('/api/create-phonepe-order?contestId={{contest.contestId}}', {
            method: 'POST',
            body: formData // Send as FormData, not JSON
          });
          orderData = await orderRes.json();
          console.log("Order data from backend:", orderData);

          if (!orderRes.ok) {
            alert('Failed to create payment order: ' + (orderData.error || 'Unknown error from server.'));
            return;
          }
        } catch (err) {
          alert('Network error during payment order creation: ' + err.message);
          return;
        }

        // Redirect to PhonePe payment page
        window.location.href = orderData.redirectUrl;
      };
    });
  </script>
  <!-- Display uploaded file or video -->
  {{#if file}}
    {{#if (contains file ".mp4") }}
      <video controls>
        <source src="data:video/mp4;base64,{{file}}">
      </video>
    {{else}}
      <img src="data:image/jpeg;base64,{{file}}" />
    {{/if}}
  {{/if}}
