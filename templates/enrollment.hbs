  <main>
    <h1>Enroll in {{contest.name}}</h1>
    <div class="popup" id="popupMessage">
      <p>You are already enrolled in this contest!</p>
    </div>

    <form id="enrollmentForm" action="/api/create-phonepe-order" method="POST" enctype="multipart/form-data">
      <!-- Add a hidden input to carry the contestId -->
      <input type="hidden" name="contestId" value="{{contest.contestId}}"/>

      <label for="userName">Name:</label>
      <input type="text" id="userName" name="userName" value="{{userName}}" readonly />

      <label for="email">Email:</label>
      <input type="email" id="email" name="email" value="{{email}}" readonly />

      <label for="phone">Phone Number:</label>
      <input type="tel" id="phone" name="phone" pattern="[0-9]{10}" maxlength="10" required />

      <label for="file">Upload File (Image/Video):</label>
      <input type="file" id="file" name="file" accept="image/*,video/*" required />

      <button id="enrollButton" type="button">Pay and enroll</button>
    </form>
    <p>Amount to pay: ₹{{contest.price}}</p>

  </main>
  <main>
