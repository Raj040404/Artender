<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Character Set & Viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Web App Capabilities -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/logo32.png">

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="192x192" href="/logo/logo192.png">
    <link rel="apple-touch-icon" sizes="512x512" href="/logo/logo512.png">

    <!-- Social Media & SEO -->
    <meta name="theme-color" content="#f97316">
    <meta property="og:title" content="Artender">
    <meta property="og:description" content="Verify your OTP">
    <meta property="og:image" content="/logo/WhatsApp%20Image%202025-02-23%20at%2000.10.41_0364758d.jpg">
    <meta property="og:url" content="http://www.artender.in">
    <meta property="og:type" content="website">
    <meta property="twitter:card" content="summary_large_image">

    <title>Verify OTP - Artender</title>

    <style>
        /* Background with art-inspired gradient */
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            /* 🎨 Static artistic color blend */
            background: linear-gradient(135deg, #ffecd2, #fcb69f, #a1c4fd, #c2e9fb);
            background-size: 400% 400%;
            animation: gradientMove 15s ease infinite;

            /* Layout & color */
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #333;
        }

        /* Smooth gradient movement for depth */
        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Glassy effect for the login container */
        .login-container {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 2rem 2.5rem;
            border-radius: 1.2rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 420px;
            animation: fadeIn 0.5s ease-in-out;
        }

        h2 {
            text-align: center;
            color: #3399cc;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 1.2rem;
        }

        /* Error box */
        .error-box {
            background-color: #ffdddd;
            border-left: 6px solid #e74c3c;
            padding: 10px 15px;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            color: #b02a1b;
            animation: slideDown 0.4s ease-out;
        }

        /* Form */
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            font-weight: 500;
            margin-bottom: 0.3rem;
            display: block;
            color: #555;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 0.7rem;
            border: 1px solid #ccc;
            border-radius: 0.6rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #3399cc;
            box-shadow: 0 0 0 3px rgba(51, 153, 204, 0.2);
        }

        /* Submit button */
        .form-group input[type="submit"],
        #resendOtpBtn {
            background: linear-gradient(90deg, #3399cc, #66cdaa);
            border: none;
            color: white;
            font-size: 1rem;
            padding: 0.8rem;
            border-radius: 0.6rem;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            width: 100%;
        }

        .form-group input[type="submit"]:hover,
        #resendOtpBtn:not(:disabled):hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(51, 153, 204, 0.25);
        }

        /* Disabled button style */
        #resendOtpBtn:disabled {
            background: linear-gradient(90deg, #cccccc, #aaaaaa);
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        /* Links and messages */
        p {
            text-align: center;
            margin-bottom: 1rem;
        }

        #resendMsg {
            text-align: center;
            margin-top: 1rem;
            color: #2e7d32;
        }

        /* Timer display */
        .timer-display {
            text-align: center;
            margin-top: 0.5rem;
            font-size: 0.9rem;
            color: #666;
            font-weight: 500;
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive */
        @media (max-width: 500px) {
            .login-container {
                padding: 1.5rem;
                margin: 1rem;
                width: auto;
            }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h2>Verify Your OTP</h2>

        <!-- ✅ Error Message Box -->
        {{#if error}}
        <div id="errorBox" class="error-box">
            {{error}}
        </div>
        {{/if}}

        <p>We have sent an OTP to <strong>{{email}}</strong>. Please enter it below to complete your signup.</p>

        <form id="otpForm" class="login-form" action="/verify-otp" method="post">
            <input type="hidden" name="email" value="{{email}}" />

            <div class="form-group">
                <label for="otp">Enter OTP:</label>
                <input type="text" id="otp" name="otp" required maxlength="6" autocomplete="off" />
            </div>

            <div class="form-group">
                <input type="submit" value="Verify OTP">
            </div>
        </form>

        <div class="form-group">
            <button id="resendOtpBtn" disabled>Resend OTP (<span id="timer">20</span>s)</button>
        </div>
        <div id="timerDisplay" class="timer-display"></div>
        <p id="resendMsg" style="display: none;">OTP Resent Successfully!</p>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const errorBox = document.getElementById('errorBox');
            const resendOtpBtn = document.getElementById('resendOtpBtn');
            const resendMsg = document.getElementById('resendMsg');
            const timerDisplay = document.getElementById('timerDisplay');
            const timerSpan = document.getElementById('timer');
            
            let countdownTimer;
            let countdownTime = 20; // Initial lock for 20 seconds
            const lockAfterClick = 30; // Lock for 30 seconds after clicking

            // ✅ Start the countdown timer
            function startCountdown(seconds) {
                countdownTime = seconds;
                timerSpan.textContent = countdownTime;
                resendOtpBtn.disabled = true;
                timerDisplay.textContent = `You can resend OTP in ${countdownTime} seconds`;
                
                countdownTimer = setInterval(() => {
                    countdownTime--;
                    timerSpan.textContent = countdownTime;
                    timerDisplay.textContent = `You can resend OTP in ${countdownTime} seconds`;
                    
                    if (countdownTime <= 0) {
                        clearInterval(countdownTimer);
                        resendOtpBtn.disabled = false;
                        resendOtpBtn.innerHTML = 'Resend OTP';
                        timerDisplay.textContent = '';
                    }
                }, 1000);
            }

            // ✅ Start initial 20-second countdown when page loads
            startCountdown(20);

            // ✅ Hide Error Message After 3 Seconds
            if (errorBox) {
                setTimeout(() => {
                    errorBox.style.opacity = "0";
                    setTimeout(() => errorBox.style.display = "none", 500);
                }, 3000);
            }

            // ✅ Resend OTP Function
            resendOtpBtn.addEventListener("click", async function () {
                if (resendOtpBtn.disabled) return;
                
                const email = "{{email}}";
                try {
                    const response = await fetch("/resend-otp", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email }),
                    });

                    const data = await response.json();
                    if (data.success) {
                        // Show success message
                        resendMsg.style.display = "block";
                        setTimeout(() => { resendMsg.style.display = "none"; }, 3000);
                        
                        // Start 30-second countdown after successful resend
                        startCountdown(lockAfterClick);
                    } else {
                        alert("Failed to resend OTP. Please try again.");
                    }
                } catch (error) {
                    console.error("Error resending OTP:", error);
                    alert("An error occurred. Please try again.");
                }
            });
        });
    </script>
</body>

</html>
