<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="/css/profile.css">


</head>

<body>
    <header>
        <div class="logo">
            <a href="/home" style="text-decoration: none; color: inherit;">Artender</a>
        </div>
        <nav>
            <a href="/home">Home</a>
            <a href="/explorecompetitions">Explore Competitions</a>
            <a href="/profile">Profile</a>
            <a href="/logout">Logout</a>
        </nav>
    </header>

    <main>
        <!-- User Info Section -->
        <section id="userInfo" class="profile-section">
            <div class="user-info">
                {{#if profilePicture}}
                <img src="data:image/jpeg;base64,{{profilePicture}}" alt="Profile Picture" />
                {{else}}
                <div class="no-image">No profile picture</div>
                {{/if}}
                <div class="details">
                    <h2>{{name}}</h2>
                    <p>Email: {{email}}</p>
                    <p>{{bio}}</p>
                    <p>{{location}}</p>
                </div>
                <div class="stats">
                    <p><strong>Followers:</strong> {{followers}}</p>
                </div>
            </div>
            <button id="editProfileBtn">Edit Profile</button>
        </section>

        <!-- Edit Profile Form -->
        <section id="editProfileForm" class="edit-profile-form">
            <form action="/updateProfile" method="POST" enctype="multipart/form-data">
                <label for="bio">Bio:</label>
                <textarea id="bio" name="bio">{{bio}}</textarea>

                <label for="location">Location:</label>
                <input type="text" id="location" name="location" value="{{location}}" />

                <!-- Profile Picture Upload -->
                <label for="profilePicture">Profile Picture:</label>
                <input type="file" id="profilePicture" name="profilePicture" accept="image/*" />

                <button type="submit">Update Profile</button>
                <button type="button" id="cancelEditBtn">Cancel</button>
            </form>
        </section>

        <!-- Enrolled Contests Section -->
        <section id="enrolledContests" class="profile-section">
            <h3>Enrolled Contests</h3>
            {{#if enrolledContests.length}}
            {{#each enrolledContests}}
            <div class="contest">
                <h4>{{name}}</h4>
                {{#if poster}}
                <img src="{{poster}}" alt="{{name}} Poster" />
                {{/if}}
                <div class="contest-details">
                    <p><strong>Start Date:</strong> {{deadline}}</p>
                    <p><strong>Price:</strong> ${{price}}</p>
                    <p><strong>Type:</strong> {{type}}</p>
                    <p><strong>Theme:</strong> {{theme}}</p>
                </div>
            </div>
            {{/each}}
            {{else}}
            <p>No contests enrolled yet.</p>
            {{/if}}
        </section>

        <!-- User's Posts Section -->
        <section id="userPosts" class="profile-section">
            <h3>Your Posts</h3>
            <div class="user-posts">
                {{#if posts.length}}
                {{#each posts}}
                <article>
                    <p>{{description}}</p>
                    {{#if file}}
                    {{#if (startsWith fileType "image/")}}
                    <img src="data:{{fileType}};base64,{{file}}" alt="Uploaded Image">
                    {{else if (startsWith fileType "video/")}}
                    <video controls>
                        <source src="data:{{fileType}};base64,{{file}}" type="{{fileType}}">
                        Your browser does not support the video tag.
                    </video>
                    {{/if}}
                    {{/if}}
                    <small>Posted on: {{createdAt}}</small>
                    <!-- Like Button inside a post -->
                    <button class="like-button" data-username="{{username}}" data-post-no="{{postNo}}"
                        style="font-size: 14px;">
                        Like (<span class="like-count">{{this.likes.length}}</span>)
                    </button>

                </article>
                {{/each}}
                {{else}}
                <p>No posts to show.</p>
                {{/if}}
            </div>
        </section>
    </main>

    <script>
        // Toggle Edit Profile Form
        document.getElementById("editProfileBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "block";
        });

        document.getElementById("cancelEditBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "none";
        });

        document.addEventListener("DOMContentLoaded", () => {
            const likeButtons = document.querySelectorAll(".like-button");

            likeButtons.forEach((button) => {
                const username = button.getAttribute("data-username");
                const postNo = button.getAttribute("data-post-no");

                button.addEventListener("click", async () => {

                    if (!username || !postNo) {
                        console.error("Missing username or postNo for like button.");
                        return;
                    }

                    try {
                        const response = await fetch("/like", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ username, postNo }),
                        });

                        if (response.ok) {
                            const data = await response.json();
                            button.classList.add("liked");
                            button.querySelector(".like-count").textContent = data.likes;
                            button.textContent = `Liked (${data.likes})`;
                        } else {
                            const errorMessage = await response.text();
                            alert(`Failed to like the post: ${errorMessage}`);
                        }
                    } catch (error) {
                        console.error("Error liking the post:", error);
                    }
                });
            });
        });
    </script>
</body>

</html>