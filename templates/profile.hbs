    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Web App Capabilities -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Favicon (Browser Tabs) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/logo32.png">

    <!-- Apple Touch Icons (iOS Home Screen) -->
    <link rel="apple-touch-icon" sizes="192x192" href="/logo/logo192.png">
    <link rel="apple-touch-icon" sizes="512x512" href="/logo/logo512.png">

    <!-- Social Media & SEO Meta Tags -->
