    <script>

        function toggleNavbar() {
            const navbarMenu = document.getElementById("navbarMenu");
            navbarMenu.style.display = navbarMenu.style.display === "flex" ? "none" : "flex";
        }

        document.addEventListener("keydown", function (e) {
            if (e.ctrlKey && e.shiftKey && (e.key === "s")) {
                e.preventDefault();
                alert("Screenshots are disabled!");
            }
        });
        document.addEventListener("keydown", function (e) {
            if (e.key === "PrintScreen") {
                e.preventDefault();
                alert("Screenshots are disabled!");
            }
        });
        document.addEventListener("keydown", function (e) {
            if (e.ctrlKey && (e.key === "u" || e.key === "U" || e.key === "i" || e.key === "I")) {
                e.preventDefault();
                alert("View Source and Inspect Element are disabled!");
            }
        });

        // Toggle Edit Profile Form
        document.getElementById("editProfileBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "block";
        });

        document.getElementById("cancelEditBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "none";
        });

        document.addEventListener("DOMContentLoaded", () => {
            const likeButtons = document.querySelectorAll(".like-button");

            likeButtons.forEach((button) => {
                const username = button.getAttribute("data-username");
                const postNo = button.getAttribute("data-post-no");

                button.addEventListener("click", async () => {
                    try {
                        const response = await fetch("/like", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ username, postNo }),
                        });

                        if (response.ok) {
                            const data = await response.json();

                            if (data.isLiked) {
                                button.classList.add("liked");
                                button.textContent = `Liked (${data.likes})`;
                            } else {
                                button.classList.remove("liked");
                                button.textContent = `Like (${data.likes})`;
                            }

                            button.querySelector(".like-count").textContent = data.likes;
                        } else {
                            console.error("Failed to like the post.");
                        }
                    } catch (error) {
                        console.error("Error liking the post:", error);
                    }
                });
            });
        });

        function toggleMenu(postNo) {
            let menu = document.getElementById(`menu-${postNo}`);
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }

        // Close dropdown when clicking outside
        document.addEventListener("click", function (event) {
            if (!event.target.closest(".options-menu")) {
                document.querySelectorAll(".menu-dropdown").forEach(menu => menu.style.display = "none");
            }
        });

        function editPost(postNo, oldDesc) {
            let newDesc = prompt("Edit your description:", oldDesc);
            if (newDesc !== null && newDesc.trim() !== "") {
                fetch(`/edit-post/${postNo}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `description=${encodeURIComponent(newDesc)}`
                }).then(response => {
                    if (response.ok) {
                        document.getElementById(`desc-${postNo}`).innerText = newDesc;
                    } else {
                        alert("Error updating description. Try again.");
                    }
                });
            }
        }
        let cropper;

        // Toggle Edit Profile Form
        document.getElementById("editProfileBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "block";
        });

        document.getElementById("cancelEditBtn").addEventListener("click", () => {
            document.getElementById("editProfileForm").style.display = "none";
            if (cropper) {
                cropper.destroy(); // Clean up cropper instance
            }
            document.getElementById("imagePreview").style.display = "none";
        });

        // Handle Image Upload and Cropping
        document.getElementById("profilePicture").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (file && file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const img = document.getElementById("imageToCrop");
                    img.src = event.target.result;
                    document.getElementById("imagePreview").style.display = "block";

                    // Destroy previous cropper instance if it exists
                    if (cropper) {
                        cropper.destroy();
                    }

                    // Initialize Cropper.js with aspect ratio matching user-info img (250x200)
                    cropper = new Cropper(img, {
                        aspectRatio: 250 / 200, // Match the user-info img dimensions
                        viewMode: 1, // Restrict crop box to image bounds
                        autoCropArea: 0.8, // Default crop area size
                        responsive: true,
                    });
                };
                reader.readAsDataURL(file);
            }
        });

        // Crop Image Button
        document.getElementById("cropImageBtn").addEventListener("click", function () {
            if (cropper) {
                const canvas = cropper.getCroppedCanvas({
                    width: 250, // Match front-end display size
                    height: 200,
                });
                const croppedImageData = canvas.toDataURL("image/jpeg"); // Convert to base64
                document.getElementById("croppedImageData").value = croppedImageData; // Store in hidden input
                document.getElementById("imageToCrop").src = croppedImageData; // Update preview
                cropper.destroy(); // Destroy cropper after cropping
                cropper = null;
            }
        });

        // Reset Crop Button
        document.getElementById("resetCropBtn").addEventListener("click", function () {
            if (cropper) {
                cropper.reset();
            }
        });

        // Form Submission
        document.querySelector("#editProfileForm form").addEventListener("submit", function (e) {
            if (cropper) {
                e.preventDefault();
                alert("Please crop the image before submitting.");
            }
        });

        // Existing toggleNavbar, like button, and menu functions remain unchanged
        function toggleNavbar() {
            const navbarMenu = document.getElementById("navbarMenu");
            navbarMenu.style.display = navbarMenu.style.display === "flex" ? "none" : "flex";
        }

        // ... Rest of your existing JavaScript (like buttons, menu toggle, etc.) ...

    </script>
