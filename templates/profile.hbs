    <main>
        <!-- User Info Section -->
        <section id="userInfo" class="profile-section">
            <div class="user-info">
                {{#if profilePicture}}
                <img src="data:image/jpeg;base64,{{profilePicture}}" alt="Profile Picture" />
                {{else}}
                <div class="no-image">No profile picture</div>
                {{/if}}
                <div class="details">
                    <h2>{{name}}</h2>
                    <p>Email: {{email}}</p>
                    <p>{{bio}}</p>
                    <p>{{location}}</p>
                </div>
                <div class="stats">
                    <p><strong>Followers:</strong> {{followers}}</p>
                </div>
            </div>
            <button id="editProfileBtn">Edit Profile</button>
        </section>

        <!-- Edit Profile Form -->
        <!-- Edit Profile Form -->
        <section id="editProfileForm" class="edit-profile-form">
            <form action="/updateProfile" method="POST" enctype="multipart/form-data">
                <label for="bio">Bio:</label>
                <textarea id="bio" name="bio">{{bio}}</textarea>

                <label for="location">Location:</label>
                <input type="text" id="location" name="location" value="{{location}}" />

                <label for="profilePicture">Profile Picture:</label>
                <input type="file" id="profilePicture" name="profilePicture" accept="image/*" />

                <!-- Image Preview and Cropping Area -->
                <div id="imagePreview" style="display: none; margin-top: 10px;">
                    <img id="imageToCrop" style="max-width: 100%; max-height: 400px;" />
                    <div style="margin-top: 10px;">
                        <button type="button" id="cropImageBtn">Crop Image</button>
                        <button type="button" id="resetCropBtn">Reset</button>
                    </div>
                </div>
                <!-- Hidden input to store cropped image data -->
                <input type="hidden" id="croppedImageData" name="croppedImageData" />

                <button type="submit">Update Profile</button>
                <button type="button" id="cancelEditBtn">Cancel</button>
            </form>
        </section>

        <!-- Enrolled Contests Section -->
        <section id="enrolledContests" class="profile-section">
            <h3>Enrolled Contests</h3>
            {{#if enrolledContests.length}}
            {{#each enrolledContests}}
            <div class="contest">
                <h4>{{name}}</h4>
                {{#if poster}}
                <img src="{{poster}}" alt="{{name}} Poster" />
                {{/if}}
                <div class="contest-details">
                    <p><strong>Start Date:</strong> {{deadline}}</p>
                    <p><strong>Price:</strong> ${{price}}</p>
                    <p><strong>Type:</strong> {{type}}</p>
                    <p><strong>Theme:</strong> {{theme}}</p>
                </div>
            </div>
            {{/each}}
            {{else}}
            <p>No contests enrolled yet.</p>
            {{/if}}
        </section>

        <!-- User's Posts Section -->
        <section id="userPosts" class="profile-section">
            <h3>Your Posts</h3>
            <div class="user-posts">
                {{#if posts.length}}
                {{#each posts}}
                <article class="post-item">
                    <div class="post-header">
                        <h4>Post #{{postNo}}</h4>

                        <!-- SVG Options Menu at Rightmost Corner -->
                        <div class="options-menu">
                            <svg onclick="toggleMenu('{{postNo}}')" width="24" height="24" viewBox="0 0 24 24"
                                fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="5" r="2" fill="#FFF" />
                                <circle cx="12" cy="12" r="2" fill="#FFF" />
                                <circle cx="12" cy="19" r="2" fill="#FFF" />
                            </svg>
                            <div class="menu-dropdown" id="menu-{{postNo}}">
                                <button onclick="editPost('{{postNo}}', '{{description}}')">✏️ Edit</button>
                                <form action="/delete-post/{{postNo}}" method="POST">
                                    <button type="submit">🗑 Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="post-media">
                        {{#if file}}
                        {{#if (startsWith fileType "image/")}}
                        <img src="data:{{fileType}};base64,{{file}}" alt="Uploaded Image" class="post-image">
                        {{else if (startsWith fileType "video/")}}
                        <video controls class="post-video">
                            <source src="data:{{fileType}};base64,{{file}}" type="{{fileType}}">
                        </video>
                        {{/if}}
                        {{/if}}
                    </div>
                    <div class="post-content">
                        <p id="desc-{{postNo}}">{{description}}</p>
                    </div>
                    <div class="like-container">
                        <button class="like-button {{#if isLiked}}liked{{/if}}" data-username="{{username}}"
                            data-post-no="{{postNo}}">
                            <span class="button-text">{{#if isLiked}}Liked{{else}}Like{{/if}}</span>
                            (<span class="like-count">{{likeCount}}</span>)
                        </button>
                    </div>
                </article>
                {{/each}}
                {{else}}
                <p>No posts to show.</p>
                {{/if}}
            </div>
        </section>
    </main>
