<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <!-- Character Set & Viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Web App Capabilities -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/logo32.png">

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="192x192" href="/logo/logo192.png">
    <link rel="apple-touch-icon" sizes="512x512" href="/logo/logo512.png">

    <!-- Social Media & SEO -->
    <meta name="theme-color" content="#f97316">
    <meta property="og:title" content="Artender">
    <meta property="og:description" content="Login to your account">
    <meta property="og:image" content="/logo/WhatsApp%20Image%202025-02-23%20at%2000.10.41_0364758d.jpg">
    <meta property="og:url" content="http://www.artender.in">
    <meta property="og:type" content="website">
    <meta property="twitter:card" content="summary_large_image">

    <title>Login - Artender</title>

    <style>
        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #ffecd2, #fcb69f, #a1c4fd, #c2e9fb);
            background-size: 400% 400%;
            animation: gradientMove 15s ease infinite;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            color: #333;
        }

        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .login-container {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: clamp(1.5rem, 4vw, 2.5rem);
            border-radius: 1.2rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 420px;
            animation: fadeIn 0.5s ease-in-out;
        }

        h2 {
            text-align: center;
            color: #3399cc;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 1.2rem;
            font-size: clamp(1.5rem, 4vw, 2rem);
        }

        .error-box {
            background-color: #ffdddd;
            border-left: 6px solid #e74c3c;
            padding: 10px 15px;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            color: #b02a1b;
            animation: slideDown 0.4s ease-out;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .form-group label {
            font-weight: 500;
            margin-bottom: 0.3rem;
            display: block;
            color: #555;
            font-size: 0.9rem;
        }

        .form-group select,
        .form-group input[type="text"],
        .form-group input[type="password"] {
            width: 100%;
            padding: 0.875rem;
            border: 1px solid #ccc;
            border-radius: 0.6rem;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-group select:focus,
        .form-group input:focus {
            outline: none;
            border-color: #3399cc;
            box-shadow: 0 0 0 3px rgba(51, 153, 204, 0.2);
        }

        .form-group input[type="submit"] {
            background: linear-gradient(90deg, #3399cc, #66cdaa);
            border: none;
            color: white;
            font-size: 1rem;
            padding: 0.8rem;
            border-radius: 0.6rem;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            margin-top: 0.5rem;
        }

        .form-group input[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(51, 153, 204, 0.25);
        }

        a {
            color: #3399cc;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        a:hover {
            color: #267399;
        }

        .form-group[style*="text-align:center"] {
            text-align: center;
            margin-top: 0.5rem;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Mobile optimizations - ONLY responsive changes */
        @media (max-width: 480px) {
            body { padding: 0.5rem; }
            .login-container { padding: 1.5rem; }
            .form-group select,
            .form-group input { font-size: 16px; } /* Prevents zoom on iOS */
        }

        /* Landscape mobile */
        @media (max-height: 600px) and (orientation: landscape) {
            body { align-items: flex-start; padding-top: 1rem; }
            .login-container { margin: 1rem 0; }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h2>Login</h2>

        <!-- ✅ Error Message Box -->
        {{#if error}}
        <div class="error-box" id="errorBox">
            {{error}}
        </div>
        {{/if}}

        <form class="login-form" method="post" action="/login">
            <div class="form-group">
                <label for="loginType">Login via:</label>
                <select id="loginType" name="loginType">
                    <option value="email">Email</option>
                    <option value="username">Username</option>
                </select>
            </div>

            <div class="form-group">
                <label for="loginInput">Enter Email or Username:</label>
                <input type="text" id="loginInput" name="loginInput" required autocomplete="off" />
            </div>

            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required autocomplete="off" />
            </div>

            <div class="form-group">
                <input type="submit" value="Login">
            </div>
            <div class="form-group" style="text-align:center;">
                <a href="/forgot-password">Forgot Password?</a>
            </div>
            <div class="form-group" style="text-align:center;">
                <p>Don't have an account? <a href="/signup">Register</a></p>
            </div>
        </form>
    </div>

    <script>
        // ✅ Hide error message after 3 seconds
        document.addEventListener("DOMContentLoaded", function () {
            const errorBox = document.getElementById("errorBox");
            if (errorBox) {
                setTimeout(() => {
                    errorBox.style.opacity = "0";
                    setTimeout(() => errorBox.style.display = "none", 500);
                }, 3000);
            }
        });
    </script>
</body>

</html>
