<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <!-- Character Set & Viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Web App Capabilities -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/logo32.png">

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="192x192" href="/logo/logo192.png">
    <link rel="apple-touch-icon" sizes="512x512" href="/logo/logo512.png">

    <!-- Social Media & SEO -->
    <meta name="theme-color" content="#3399cc">
    <meta property="og:title" content="Artender">
    <meta property="og:description" content="Login to your account">
    <meta property="og:image" content="/logo/WhatsApp%20Image%202025-02-23%20at%2000.10.41_0364758d.jpg">
    <meta property="og:url" content="http://www.artender.in">
    <meta property="og:type" content="website">
    <meta property="twitter:card" content="summary_large_image">

    <title>Login - Artender</title>

    <style>
        /* Background with art-inspired gradient */
       body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: 
        linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.85)),
        url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1920' height='1080'><defs><linearGradient id='g' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='%23ffe3d8'/><stop offset='100%' stop-color='%23d8f0ff'/></linearGradient></defs><rect width='1920' height='1080' fill='url(%23g)'/><path d='M0,300 C400,200 800,400 1200,300 C1600,200 1920,400 1920,400 L1920,1080 L0,1080 Z' fill='%23f9c0bb' opacity='0.4'/><path d='M0,500 C500,600 1000,300 1500,500 C1800,600 1920,500 1920,500 L1920,1080 L0,1080 Z' fill='%23a6dcef' opacity='0.35'/></svg>");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #333;
}


        .login-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            padding: 2rem 2.5rem;
            border-radius: 1.2rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 420px;
            animation: fadeIn 0.8s ease-in-out;
        }

        h2 {
            text-align: center;
            color: #3399cc;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 1.2rem;
        }

        /* Error box */
        .error-box {
            background-color: #ffdddd;
            border-left: 6px solid #e74c3c;
            padding: 10px 15px;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            color: #b02a1b;
            animation: slideDown 0.4s ease-out;
        }

        /* Form */
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .form-group label {
            font-weight: 500;
            margin-bottom: 0.3rem;
            display: block;
            color: #555;
        }

        .form-group select,
        .form-group input[type="text"],
        .form-group input[type="password"] {
            width: 100%;
            padding: 0.7rem;
            border: 1px solid #ccc;
            border-radius: 0.6rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-group select:focus,
        .form-group input:focus {
            outline: none;
            border-color: #3399cc;
            box-shadow: 0 0 0 3px rgba(51, 153, 204, 0.2);
        }

        /* Submit button */
        .form-group input[type="submit"] {
            background: linear-gradient(90deg, #3399cc, #66cdaa);
            border: none;
            color: white;
            font-size: 1rem;
            padding: 0.8rem;
            border-radius: 0.6rem;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group input[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(51, 153, 204, 0.25);
        }

        /* Links */
        a {
            color: #3399cc;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        a:hover {
            color: #267399;
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive */
        @media (max-width: 500px) {
            .login-container {
                padding: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h2>Login</h2>

        <!-- ✅ Error Message Box -->
        {{#if error}}
        <div class="error-box" id="errorBox">
            {{error}}
        </div>
        {{/if}}

        <form class="login-form" method="post" action="/login">
            <div class="form-group">
                <label for="loginType">Login via:</label>
                <select id="loginType" name="loginType">
                    <option value="email">Email</option>
                    <option value="username">Username</option>
                </select>
            </div>

            <div class="form-group">
                <label for="loginInput">Enter Email or Username:</label>
                <input type="text" id="loginInput" name="loginInput" required autocomplete="off" />
            </div>

            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required autocomplete="off" />
            </div>

            <div class="form-group">
                <input type="submit" value="Login">
            </div>
            <div class="form-group" style="text-align:center;">
                <a href="/forgot-password">Forgot Password?</a>
            </div>
            <div class="form-group" style="text-align:center;">
                <p>Don't have an account? <a href="/signup">Register</a></p>
            </div>
        </form>
    </div>

    <script>
        // ✅ Hide error message after 3 seconds
        document.addEventListener("DOMContentLoaded", function () {
            const errorBox = document.getElementById("errorBox");
            if (errorBox) {
                setTimeout(() => {
                    errorBox.style.opacity = "0";
                    setTimeout(() => errorBox.style.display = "none", 500);
                }, 3000);
            }
        });
    </script>
</body>

</html>
