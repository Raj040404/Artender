<div class="shop-container">

    <div class="shop-header">
        <h1 class="shop-title">EliteStore</h1>

        <a href="/cart" class="cart-btn">
            🛒 Cart
        </a>
    </div>

    <div class="shop-product-grid">

        {{#each products}}

        <div class="shop-product-card">

            <div class="shop-img-container">

                <img src="{{this.imageUrl}}" alt="{{this.name}}" class="shop-product-img">

                {{#if this.isNewItem}}
                <span class="shop-badge shop-badge-new">NEW</span>
                {{/if}}

                {{#if this.discountPercentage}}
                <span class="shop-badge shop-badge-discount">-{{this.discountPercentage}}%</span>
                {{/if}}

                <button class="shop-wishlist-btn">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                        <path
                            d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3z"/>
                    </svg>
                </button>

            </div>

            <div class="shop-product-info">

                <h3 class="shop-product-title">{{this.name}}</h3>

                <div class="shop-product-rating">
                    <div class="shop-stars" style="--rating: {{this.rating}};">
                        ★★★★★
                    </div>
                    <span class="shop-reviews-count">({{this.reviewsCount}})</span>
                </div>

                <div class="shop-product-price-row">
                    <span class="shop-price-current">₹{{this.price}}</span>

                    {{#if this.originalPrice}}
                    <span class="shop-price-original">₹{{this.originalPrice}}</span>
                    {{/if}}
                </div>

                <div class="shop-product-actions">

                    <button class="shop-buy-btn"
                        onclick="addToCart('{{this._id}}')">
                        Add to Cart
                    </button>

                    <button class="shop-details-btn"
                        onclick="viewDetails(
                            '{{this.name}}',
                            `{{this.description}}`,
                            '{{this.price}}',
                            '{{this.originalPrice}}',
                            '{{this.imageUrl}}',
                            '{{this.rating}}',
                            '{{this.reviewsCount}}'
                        )">
                        View Details
                    </button>

                </div>

            </div>

        </div>

        {{else}}

        <div style="text-align:center; grid-column: 1 / -1; padding: 40px;">
            <h2>No Products Found</h2>
            <p>Please check back later.</p>
        </div>

        {{/each}}

