/* ===== Shop Coming Soon — Artistic Theme ===== */

.about-main{
    min-height:80vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 20px;
    font-family:'Noto Sans', sans-serif;
    background: linear-gradient(135deg, #fff7ed, #ffffff);
}

/* Wrapper */
.coming-soon-wrapper{
    text-align:center;
    max-width:800px;
    animation: fadeIn 1.2s ease-in-out;
}

/* Title */
.coming-title{
    font-size:48px;
    font-weight:800;
    background: linear-gradient(90deg, #f97316, #ea580c, #c2410c);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    margin-bottom:20px;
    letter-spacing:1px;
}

/* Subtitle */
.coming-subtitle{
    font-size:18px;
    color:#4b5563;
    line-height:1.8;
    margin-bottom:40px;
}

/* Artistic Paint Stroke */
.paint-line{
    height:6px;
    width:200px;
    margin:0 auto;
    background: linear-gradient(90deg, #f97316, #fb923c, #fdba74);
    border-radius:50px;
    animation: expandLine 2s ease-in-out infinite alternate;
}

/* Animations */
@keyframes expandLine{
    from{ width:120px; opacity:0.6; }
    to{ width:260px; opacity:1; }
}

@keyframes fadeIn{
    from{ opacity:0; transform:translateY(20px); }
    to{ opacity:1; transform:translateY(0); }
}

/* Responsive */
@media(max-width:768px){
    .coming-title{
        font-size:32px;
    }
    .coming-subtitle{
        font-size:16px;
    }
}
</style>

