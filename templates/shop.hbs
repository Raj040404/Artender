                        {{#if this.originalPrice}}
                        <span class="shop-price-original">₹{{this.originalPrice}}</span>
                        {{/if}}
                    </div>
                    <button class="shop-buy-btn" style="position: relative; z-index: 20;"
                        onclick="buyProduct('{{this._id}}')">Buy Now</button>
                </div>
            </div>
            {{else}}
