<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Seller Registration Payment | Artender</title>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f3ef, #ffffff);
            color: #222;
        }

        .container {
            max-width: 520px;
            margin: 40px auto;
            padding: 20px;
        }

        .card {
            background: #fff;
            border-radius: 14px;
            padding: 30px 25px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }

        .logo {
            text-align: center;
            margin-bottom: 15px;
        }

        .logo img {
            width: 80px;
        }

        h2 {
            text-align: center;
            margin: 10px 0 5px;
            font-weight: 600;
        }

        .subtitle {
            text-align: center;
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }

        .price {
            text-align: center;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 13px;
            border-radius: 8px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 14px;
            transition: 0.2s ease;
        }

        input:focus {
            outline: none;
            border-color: #000;
        }

        button {
            width: 100%;
            padding: 13px;
            background: #000;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
            transition: 0.2s ease;
        }

        button:hover {
            opacity: 0.9;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .error {
            color: red;
            margin-bottom: 10px;
            font-size: 13px;
            text-align: center;
        }

        .loader {
            margin-top: 10px;
            font-size: 13px;
            color: #555;
            text-align: center;
        }

        .info-section {
            margin-top: 25px;
            background: #fafafa;
            padding: 18px;
            border-radius: 10px;
            border: 1px solid #eee;
        }

        .info-section h3 {
            margin: 0 0 8px;
            font-size: 15px;
        }

        .info-section p, .info-section li {
            font-size: 13px;
            color: #555;
            line-height: 1.6;
        }

        ul {
            padding-left: 18px;
            margin: 0;
        }

        .footer-note {
            text-align: center;
            font-size: 12px;
            color: #777;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card">

        <div class="logo">
            <img src="/logo/logo192.png" alt="Artender Logo">
        </div>

        <h2>Become a Seller on Artender</h2>
        <div class="subtitle">Showcase and sell your artwork to art lovers across India</div>

        <div class="price">One-time Registration Fee: ₹1</div>

        <div id="error" class="error"></div>

        <input 
            type="tel" 
            id="phone" 
            placeholder="Enter 10-digit mobile number" 
            maxlength="10"
        />

        <button id="payBtn" onclick="pay()">Proceed to Secure Payment</button>

        <div id="loader" class="loader"></div>

        <!-- Why Fee Section -->
        <div class="info-section">
            <h3>Why are we charging ₹1?</h3>
            <p>
                This small verification fee helps us prevent fake registrations, bots, and spam sellers. 
                It ensures that every seller on Artender is genuine and serious about showcasing their artwork.
            </p>
        </div>

        <!-- Benefits Section -->
        <div class="info-section">
            <h3>Benefits of becoming a Seller</h3>
            <ul>
                <li>List and sell your artworks to a wide audience</li>
                <li>Participate in art competitions and gain recognition</li>
                <li>Build your artist profile and portfolio</li>
                <li>Secure and trusted payment processing</li>
                <li>Promotion through Artender’s platform and campaigns</li>
            </ul>
        </div>

        <!-- Trust Section -->
        <div class="info-section">
            <h3>Secure & Trusted Platform</h3>
            <p>
                Your payment is processed through a secure gateway. We do not store your payment details. 
                Artender is committed to creating a trusted ecosystem for artists and buyers.
            </p>
        </div>

        <div class="footer-note">
            By continuing, you agree to Artender’s seller guidelines and policies.
        </div>

    </div>
</div>

<script>
async function pay() {
    const phoneInput = document.getElementById("phone");
    const errorDiv = document.getElementById("error");
    const loader = document.getElementById("loader");
    const btn = document.getElementById("payBtn");

    const phone = phoneInput.value.trim();

    errorDiv.innerText = "";
    loader.innerText = "";

    if (!/^[6-9]\d{9}$/.test(phone)) {
        errorDiv.innerText = "Please enter a valid 10-digit mobile number.";
        return;
    }

    try {
        btn.disabled = true;
        loader.innerText = "Redirecting to secure payment...";

        const res = await fetch("/api/create-seller-phonepe-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                sellerId: "{{sellerId}}",
                phone: phone
            })
        });

        const data = await res.json();

        if (!data.redirectUrl) {
            throw new Error("Payment initialization failed.");
        }

        window.location.href = data.redirectUrl;

    } catch (err) {
        errorDiv.innerText = "Something went wrong. Please try again.";
        btn.disabled = false;
        loader.innerText = "";
        console.error(err);
    }
}
</script>

</body>
</html>

