<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Seller Registration Payment | Artender</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f7f7f7;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .card {
            background: #ffffff;
            width: 95%;
            max-width: 420px;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            text-align: center;
        }

        h2 {
            margin-bottom: 10px;
        }

        .price {
            font-size: 18px;
            margin-bottom: 25px;
            color: #444;
        }

        input {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #000;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .error {
            color: red;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .loader {
            margin-top: 10px;
            font-size: 13px;
            color: #555;
        }
    </style>
</head>
<body>

<div class="card">
    <h2>Complete Seller Registration</h2>
    <p class="price">Registration Fee: ₹1</p>

    <div id="error" class="error"></div>

    <input 
        type="tel" 
        id="phone" 
        placeholder="Enter 10-digit phone number" 
        maxlength="10"
    />

    <button id="payBtn" onclick="pay()">Proceed to Pay</button>

    <div id="loader" class="loader"></div>
</div>

<script>
async function pay() {
    const phoneInput = document.getElementById("phone");
    const errorDiv = document.getElementById("error");
    const loader = document.getElementById("loader");
    const btn = document.getElementById("payBtn");

    const phone = phoneInput.value.trim();

    // Reset states
    errorDiv.innerText = "";
    loader.innerText = "";

    // Basic validation
    if (!/^[6-9]\d{9}$/.test(phone)) {
        errorDiv.innerText = "Please enter a valid 10-digit mobile number.";
        return;
    }

    try {
        btn.disabled = true;
        loader.innerText = "Redirecting to secure payment...";

        const res = await fetch("/api/create-seller-phonepe-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                sellerId: "{{sellerId}}",
                phone: phone
            })
        });

        const data = await res.json();

        if (!data.redirectUrl) {
            throw new Error("Payment initialization failed.");
        }

        window.location.href = data.redirectUrl;

    } catch (err) {
        errorDiv.innerText = "Something went wrong. Please try again.";
        btn.disabled = false;
        loader.innerText = "";
        console.error(err);
    }
}
</script>

</body>
</html>
