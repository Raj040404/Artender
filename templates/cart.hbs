<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<title>Your Cart | Artender Shop</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
:root{
  --orange:#f97316;
  --orange-dark:#ea580c;
  --green:#14532d;
  --cyan:#06b6d4;
  --bg:#ecfeff;
  --text:#1f2937;
}

body{
  font-family: Arial, Helvetica, sans-serif;
  background:linear-gradient(135deg,#ecfeff,#f0fdf4,#fff7ed);
  margin:0;
  padding:0;
  color:var(--text);
}

.cart-container{
  max-width:1100px;
  margin:auto;
  padding:40px 20px;
}

.cart-title{
  font-size:38px;
  font-weight:800;
  margin-bottom:30px;
  color:var(--green);
}

.cart-item,
.address-section,
.cart-summary,
.payment-note-box,
.modal-content{
  background:rgba(255,255,255,0.95);
  backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,0.5);
  box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.cart-item{
  display:flex;
  align-items:center;
  gap:20px;
  padding:20px;
  border-radius:18px;
  margin-bottom:18px;
  transition:all .25s ease;
}

.cart-item:hover{
  transform:translateY(-4px);
  box-shadow:0 16px 35px rgba(6,182,212,0.15);
}

.cart-image{
  width:130px;
  height:130px;
  object-fit:cover;
  border-radius:14px;
  border:3px solid #cffafe;
}

.cart-product-name{font-size:22px;font-weight:700;color:var(--green)}
.cart-price{color:var(--orange);font-size:20px;font-weight:700}
.cart-quantity{color:#0f766e;font-weight:600;margin-top:6px}

button{
  transition:all .2s ease;
}

.remove-btn,.delete-btn{
  background:#dc2626;
  color:white;
  border:none;
  padding:8px 14px;
  border-radius:8px;
}

.edit-btn{
  background:var(--cyan);
  color:white;
  border:none;
  padding:8px 14px;
  border-radius:8px;
}

.add-address-btn,.checkout-btn,.save-btn{
  background:linear-gradient(135deg,var(--orange),var(--green));
  color:white;
  border:none;
  padding:12px 18px;
  border-radius:10px;
  font-weight:700;
}

.checkout-btn{
  font-size:18px;
  padding:14px 26px;
  box-shadow:0 8px 20px rgba(20,83,45,0.2);
}

.checkout-btn:hover,
.add-address-btn:hover,
.save-btn:hover{
  transform:translateY(-2px);
  opacity:0.95;
}

.address-card{
  padding:16px;
  border:1px solid #bae6fd;
  border-radius:12px;
  margin-bottom:12px;
}

.address-card:hover{
  border-color:var(--cyan);
  box-shadow:0 8px 18px rgba(6,182,212,0.12);
}

.payment-note-box{
  margin:28px 0;
  border-left:5px solid var(--orange);
  border-radius:16px;
  padding:18px;
  background:linear-gradient(135deg,#fff7ed,#ecfeff);
}

.payment-note-title{
  font-size:18px;
  font-weight:800;
  color:var(--green);
  margin-bottom:12px;
}

.payment-note-list li{
  margin-bottom:10px;
  line-height:1.7;
}

.cart-summary{
  margin-top:30px;
  padding:25px;
  border-radius:18px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.cart-total{
  font-size:28px;
  font-weight:800;
  color:var(--green);
}

.form-group input{
  width:100%;
  padding:12px;
  border:1px solid #a5f3fc;
  border-radius:10px;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.45);
  display:none;
  justify-content:center;
  align-items:center;
}

.modal-content{
  padding:28px;
  border-radius:20px;
  width:90%;
  max-width:420px;
}

@media(max-width:700px){
  .cart-item{flex-direction:column;align-items:flex-start}
  .cart-image{width:100%;height:220px}
  .cart-summary{flex-direction:column;align-items:flex-start}
}
</style>




</head>

<body>

<div class="cart-container">

<h1 class="cart-title">Your Cart</h1>

{{#if items.length}}

<div id="cart-items">

{{#each items}}

<div class="cart-item" id="item-{{this.product._id}}">

<img class="cart-image" src="{{this.product.imageUrl}}">

<div class="cart-details">

<div class="cart-product-name">
{{this.product.name}}
</div>

<div class="cart-price">
₹{{this.product.price}}
</div>

<div class="cart-quantity">
Quantity: {{this.quantity}}
</div>

<button class="remove-btn" onclick="removeItem('{{this.product._id}}')">
Remove
</button>

</div>

</div>

{{/each}}

</div>
  <div class="address-section">

<h2 style="margin-top:30px;">Delivery Address</h2>

{{#if addresses.length}}

<div class="address-list">

{{#each addresses}}

<div class="address-card">

<label>

<input 
type="radio" 
name="address" 
value="{{this._id}}"
class="address-radio"
/>

<div class="address-info">

<div>{{this.addressLine}}</div>
<div>Phone: {{this.phone}}</div>
<div>PIN: {{this.pincode}}</div>

<div style="margin-top:8px;">

<button 
class="edit-btn"
onclick='openModal(true, {
  _id: "{{this._id}}",
  addressLine: "{{this.addressLine}}",
  phone: "{{this.phone}}",
  pincode: "{{this.pincode}}"
})'>
Edit
</button>

<button onclick="deleteAddress('{{this._id}}')" class="delete-btn">
Delete
</button>

</div>

</div>

</label>

</div>

{{/each}}

</div>

{{else}}

<div style="margin-top:10px;color:#666;">
No address added yet.
</div>

{{/if}}

<button onclick="openModal()" class="add-address-btn">
+ Add Address
</button>

</div>
  <div class="payment-note-box">
  <div class="payment-note-title">Important Delivery & Payment Information</div>
  <ul class="payment-note-list">
    <li>We currently support <strong>online payment only</strong>. Cash on Delivery (COD) is not available.</li>
    <li>Expected delivery time is <strong>7–15 business days</strong>, depending on your delivery location.</li>
    <li><strong>Delivery is completely free</strong> from our side with no additional shipping charges.</li>
  </ul>
</div>


<div class="cart-summary">

<div class="cart-total">
Total: ₹<span id="cartTotal">0</span>
</div>

<button class="checkout-btn" onclick="checkout()">
Proceed to Payment
</button>
  

</div>

{{else}}

<div class="empty-cart">

Your cart is empty.

<br>

<a href="/shop" class="shop-link">
Browse Shop
</a>

</div>

{{/if}}

</div>

<script>

let items = {{{json items}}};

function calculateTotal(){

let total = 0;

items.forEach(item=>{
total += item.product.price * item.quantity;
});

document.getElementById("cartTotal").innerText = total;

}

calculateTotal();

async function removeItem(productId){

if(!confirm("Remove this item from cart?")) return;

try{

const res = await fetch('/api/cart/remove',{
method:'POST',
headers:{
"Content-Type":"application/json"
},
credentials:"include",
body:JSON.stringify({productId})
});

const data = await res.json();

if(data.success){

// remove from UI
document.getElementById("item-"+productId).remove();

// remove from local array
items = items.filter(i => i.product._id !== productId);

calculateTotal();

if(items.length === 0){
location.reload();
}

}else{
alert(data.message || "Failed to remove item");
}

}catch(err){

console.error(err);
alert("Server error");

}

}

async function checkout(){

const selectedAddress = document.querySelector(
"input[name='address']:checked"
)?.value;

if(!selectedAddress){
alert("Please select a delivery address");
return;
}

const btn = document.querySelector(".checkout-btn");
btn.disabled = true;
btn.innerText = "Processing...";

try{

const res = await fetch('/api/cart/checkout',{
method:'POST',
headers:{
"Content-Type":"application/json"
},
credentials:"include",
body:JSON.stringify({
addressId:selectedAddress
})
});

const data = await res.json();

if(data.success && data.redirectUrl){

window.location.href = data.redirectUrl;

}else{

alert(data.message || "Checkout failed");
btn.disabled=false;
btn.innerText="Proceed to Payment";

}

}catch(err){

console.error(err);
alert("Server error");

btn.disabled=false;
btn.innerText="Proceed to Payment";

}

}
  function addAddress(){

const addressLine = prompt("Enter your address");

if(!addressLine) return;

const phone = prompt("Enter phone number");

if(!phone) return;

const pincode = prompt("Enter pincode");

if(!pincode) return;

fetch("/api/address/add",{
method:"POST",
headers:{
"Content-Type":"application/json"
},
credentials:"include",
body:JSON.stringify({
addressLine,
phone,
pincode
})
})
.then(res => res.json())
.then(data => {

if(data.success){
location.reload();
}else{
alert("Failed to add address");
}

})
.catch(err=>{
console.error(err);
alert("Server error");
});

}
  function editAddress(addressId,addressLine,phone,pincode){

const newAddress = prompt("Edit address", addressLine);
if(!newAddress) return;

const newPhone = prompt("Edit phone", phone);
if(!newPhone) return;

const newPincode = prompt("Edit pincode", pincode);
if(!newPincode) return;

fetch("/api/address/edit",{
method:"POST",
headers:{
"Content-Type":"application/json"
},
credentials:"include",
body:JSON.stringify({
addressId,
addressLine:newAddress,
phone:newPhone,
pincode:newPincode
})
})
.then(res=>res.json())
.then(data=>{

if(data.success){
location.reload();
}else{
alert("Failed to update address");
}

})
.catch(err=>{
console.error(err);
alert("Server error");
});

}
  function deleteAddress(addressId){

if(!confirm("Delete this address?")) return;

fetch("/api/address/delete",{
method:"POST",
headers:{
"Content-Type":"application/json"
},
credentials:"include",
body:JSON.stringify({
addressId
})
})
.then(res=>res.json())
.then(data=>{

if(data.success){
location.reload();
}else{
alert("Failed to delete address");
}

})
.catch(err=>{
console.error(err);
alert("Server error");
});

}
  function openModal(edit=false, data=null){

document.getElementById("addressModal").style.display = "flex";

if(edit){
document.getElementById("modalTitle").innerText = "Edit Address";
document.getElementById("addressId").value = data._id;
document.getElementById("addressLine").value = data.addressLine;
document.getElementById("phone").value = data.phone;
document.getElementById("pincode").value = data.pincode;
}else{
document.getElementById("modalTitle").innerText = "Add Address";
document.getElementById("addressId").value = "";
document.getElementById("addressLine").value = "";
document.getElementById("phone").value = "";
document.getElementById("pincode").value = "";
}

}

function closeModal(){
document.getElementById("addressModal").style.display = "none";
}
  function validateForm(addressLine, phone, pincode){

// address: alphanumeric
const addressRegex = /^[a-zA-Z0-9\s,.-]+$/;

// phone: 10 digits
const phoneRegex = /^[0-9]{10}$/;

// pincode: 6 digits
const pincodeRegex = /^[0-9]{6}$/;

if(!addressLine || !phone || !pincode){
alert("All fields are required");
return false;
}

if(!addressRegex.test(addressLine)){
alert("Invalid address format");
return false;
}

if(!phoneRegex.test(phone)){
alert("Phone must be 10 digits");
return false;
}

if(!pincodeRegex.test(pincode)){
alert("Pincode must be 6 digits");
return false;
}

return true;
}
  function submitAddress(){

const addressId = document.getElementById("addressId").value;
const addressLine = document.getElementById("addressLine").value.trim();
const phone = document.getElementById("phone").value.trim();
const pincode = document.getElementById("pincode").value.trim();

if(!validateForm(addressLine, phone, pincode)) return;

const url = addressId ? "/api/address/edit" : "/api/address/add";

const payload = addressId
? { addressId, addressLine, phone, pincode }
: { addressLine, phone, pincode };

fetch(url,{
method:"POST",
headers:{ "Content-Type":"application/json" },
credentials:"include",
body:JSON.stringify(payload)
})
.then(res=>res.json())
.then(data=>{

if(data.success){
closeModal();
location.reload();
}else{
alert(data.message || "Failed");
}

})
.catch(err=>{
console.error(err);
alert("Server error");
});

}

</script>
  <!-- Address Modal -->
<div id="addressModal" class="modal">

  <div class="modal-content">

    <h2 id="modalTitle">Add Address</h2>

    <input type="hidden" id="addressId">

    <div class="form-group">
      <label>Address</label>
      <input type="text" id="addressLine" placeholder="Enter full address">
    </div>

    <div class="form-group">
      <label>Phone Number</label>
      <input type="text" id="phone" placeholder="10 digit phone">
    </div>

    <div class="form-group">
      <label>Pincode</label>
      <input type="text" id="pincode" placeholder="6 digit pincode">
    </div>

    <div class="modal-actions">
      <button onclick="submitAddress()" class="save-btn">Save</button>
      <button onclick="closeModal()" class="cancel-btn">Cancel</button>
    </div>

  </div>

</div>

</body>
</html>
